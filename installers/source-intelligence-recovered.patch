@@ -0,0 +1,69 @@
+"""Filesystem behavior checks for the standalone user installer."""
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+
+def load_installer():
+    path = Path(__file__).resolve().parents[1] / 'deploy/intelligence/install.py'
+    spec = importlib.util.spec_from_file_location('intel_installer', path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def payload(tmp_path):
+    source = tmp_path / 'payload' / 'last30days'
+    files = {'SKILL.md': '---\nname: last30days\n---\n',
+             'scripts/intelligence.py': 'print("ready")\n',
+             'scripts/lib/intelligence/delivery.py': 'READY = True\n',
+             'scripts/lib/intelligence/sources.py': 'READY = True\n'}
+    for name, content in files.items():
+        path = source / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(content, encoding='utf-8')
+    manifest = {name: hashlib.sha256((source / name).read_bytes()).hexdigest() for name in files}
+    (source.parent / 'manifest.json').write_text(json.dumps({'files': manifest}), encoding='utf-8')
+    return source
+
+
+def test_upgrade_keeps_old_skill_and_user_settings(tmp_path):
+    source = payload(tmp_path)
+    root = tmp_path / 'home' / '.agents' / 'skills'
+    old = root / 'last30days'
+    old.mkdir(parents=True)
+    (old / 'custom.txt').write_text('my existing customization')
+    settings = tmp_path / 'home' / '.config' / 'last30days' / 'private.env'
+    settings.parent.mkdir(parents=True)
+    settings.write_text('private configuration stays here')
+    result = load_installer().install(source, root)
+    assert (root / 'last30days' / 'scripts' / 'intelligence.py').is_file()
+    assert (Path(result['backup']) / 'custom.txt').read_text() == 'my existing customization'
+    assert settings.read_text() == 'private configuration stays here'
+
+
+def test_corrupt_payload_cannot_replace_existing_skill(tmp_path):
+    source = payload(tmp_path)
+    root = tmp_path / 'skills'
+    old = root / 'last30days'
+    old.mkdir(parents=True)
+    (old / 'SKILL.md').write_text('old skill')
+    (source / 'scripts/intelligence.py').write_text('corrupt')
+    with pytest.raises(ValueError):
+        load_installer().install(source, root)
+    assert (old / 'SKILL.md').read_text() == 'old skill'
+    assert list(root.iterdir()) == [old]
+
+
+def test_same_package_is_idempotent(tmp_path):
+    source = payload(tmp_path)
+    root = tmp_path / 'skills'
+    installer = load_installer()
+    installer.install(source, root)
+    second = installer.install(source, root)
+    assert second['status'] == 'already_installed'
+    assert second['backup'] is None
+    assert [p.name for p in root.iterdir()] == ['last30days']

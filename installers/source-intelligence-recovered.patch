+        results.sort(key=lambda row: row["published_at"] or "", reverse=True)
+        seen = set()
+        unique = []
+        for row in results:
+            if row["url"] not in seen:
+                seen.add(row["url"])
+                unique.append(row)
+        return unique[:count]

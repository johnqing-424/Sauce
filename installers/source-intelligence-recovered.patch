+# Copy to a private file, chmod 600, then pass its path with --env-file.
+# Existing process environment takes precedence. This file is data, never source it.
+# Keep real endpoints, tokens, chat IDs and passwords out of Git/JSON/terminal output.
+# Generic HTTPS Webhook is the recommended first destination. Empty URL means
+# actual delivery cannot succeed; dry-run report/card previews still work.
+LAST30DAYS_INTEL_CHANNELS=webhook
+LAST30DAYS_INTEL_WEBHOOK_URL=
+LAST30DAYS_INTEL_WEBHOOK_TOKEN=
+
+# To enable more channels, list them explicitly, for example:
+# LAST30DAYS_INTEL_CHANNELS=webhook,telegram,feishu
+LAST30DAYS_INTEL_TELEGRAM_BOT_TOKEN=
+LAST30DAYS_INTEL_TELEGRAM_CHAT_ID=
+LAST30DAYS_INTEL_FEISHU_WEBHOOK_URL=
+LAST30DAYS_INTEL_FEISHU_SECRET=
+LAST30DAYS_INTEL_SLACK_WEBHOOK_URL=
+LAST30DAYS_INTEL_WECOM_WEBHOOK_URL=
+
+# SMTP requires verified TLS: ssl (465) or starttls (587), never plain transport.
+LAST30DAYS_INTEL_SMTP_HOST=
+LAST30DAYS_INTEL_SMTP_PORT=465
+LAST30DAYS_INTEL_SMTP_TLS=ssl
+LAST30DAYS_INTEL_SMTP_FROM=
+LAST30DAYS_INTEL_SMTP_TO=
+LAST30DAYS_INTEL_SMTP_USERNAME=
+LAST30DAYS_INTEL_SMTP_PASSWORD=
+
+# Optional path overrides; only ~ expands in paths, not shell $HOME expressions.
+# LAST30DAYS_INTEL_CONFIG=~/.config/last30days/intelligence.json
+# LAST30DAYS_INTEL_DB=~/.local/share/last30days/research.db
+# LAST30DAYS_INTEL_REPORT_DIR=~/.local/share/last30days/intelligence/reports
+
+# X is optional and requires prior authorization plus explicit manual credentials.
+# Add "x" to JSON engine_sources and pin LAST30DAYS_X_BACKEND=bird if wanted.

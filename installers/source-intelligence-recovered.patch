+        return Document(doc_url, title=_clean(repo.get("full_name")), text="\n".join(lines), resource_type="repository",
+                        author=author or None, published_at=published, version=version, links=links, metadata=metadata, primary_basis=primary)
+
+    def _arxiv(self, url: str, budget: Budget) -> Document:
+        match = re.fullmatch(r"/(?:abs|pdf|html)/((?:\d{4}\.\d{4,5}|[a-z.-]+/\d{7})(?:v\d+)?)(?:\.pdf)?/?", urlsplit(url).path, re.I)
+        if not match:

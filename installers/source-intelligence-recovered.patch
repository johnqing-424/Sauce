+    monkeypatch.setattr(transport, "_pinned_opener", lambda url, addresses: SimpleNamespace(open=lambda req, timeout: SimulatedResponse()))
+    with pytest.raises(transport.SourceError, match="byte limit"):
+        transport._request_once("https://example.com/", 1, 16)

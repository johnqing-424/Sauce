+def modules():
+    return (
+        importlib.import_module("lib.intelligence.transport"),
+        importlib.import_module("lib.intelligence.sources"),
+        importlib.import_module("lib.intelligence.models"),
+    )
+
+
+def budget(**limits):
+    _, _, models = modules()
+    return models.Budget(models.Limits(**limits))
+
+
+def response(url, data, content_type="application/json", status=200, headers=None):
+    transport, _, _ = modules()
+    body = json.dumps(data).encode() if isinstance(data, (dict, list)) else data.encode()
+    return transport.Response(url, status, {"content-type": content_type, **(headers or {})}, body)
+
+
+class SimulatedTransport:
+    """Dependency fixture with explicit responses and real operation charging."""
+
+    def __init__(self, routes):
+        self.routes = routes
+        self.requested = []
+
+    def get(self, url, scan_budget):
+        scan_budget.take()
+        self.requested.append(url)
+        value = self.routes[url]
+        if isinstance(value, Exception):
+            raise value
+        return value
+
+
+@pytest.mark.parametrize("url", [
+    "http://example.com/", "ftp://example.com/a", "https://user:pass@example.com/",
+    "https://localhost/", "https://a.localhost/", "https://metadata.google.internal/",
+    "https://169.254.169.254/", "https://127.0.0.1/", "https://[::1]/",
+    "https://10.0.0.1/", "https://100.100.100.200/", "https://[fc00::1]/",
+    "https://2130706433/", "https://127.1/", "https://example.com:22/",
+    "https://example.com/\nX-Foo: injected", "https://example.com\\@127.0.0.1/",
+])
+def test_simulated_unsafe_targets_are_denied(url):

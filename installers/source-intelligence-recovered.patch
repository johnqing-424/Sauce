+        readme_api = api + "/readme" + ("?" + urlencode({"ref": version}) if tag and version else "")
+        try:
+            readme = _json(self._get(readme_api, budget))
+            if readme.get("encoding") != "base64":
+                raise SourceError("metadata", "unsupported README encoding")
+            try:

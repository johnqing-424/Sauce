+"""Non-secret JSON settings; delivery credentials remain environment-only."""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+from dataclasses import asdict
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+from .analysis import DEFAULT_WEIGHTS
+from .models import Limits
+from .transport import validate_local_proxy_url
+
+ENV_KEYS = frozenset({"LAST30DAYS_INTEL_CONFIG", "LAST30DAYS_INTEL_DB", "LAST30DAYS_INTEL_REPORT_DIR"})
+
+
+def load_settings(path: str | None = None) -> dict:
+    settings = {"limits": asdict(Limits()), "weights": dict(DEFAULT_WEIGHTS),
+                "threshold_a": 85, "threshold_b": 60, "confidence_threshold": .7,
+                "lookback_days": 30, "max_reports": 4, "cache_seconds": 86400,
+                "engine_sources": ["reddit", "hackernews"], "channels": [],
+                "timezone": "Asia/Shanghai", "min_delivery_interval_seconds": 1,
+                "source_check_interval_seconds": 3600, "local_proxy_url": None,
+                "db": str(Path.home() / ".local/share/last30days/research.db"),
+                "report_dir": str(Path.home() / ".local/share/last30days/intelligence/reports")}
+    file_path = path or os.environ.get("LAST30DAYS_INTEL_CONFIG")
+    if not file_path:
+        default_file = Path.home() / '.config/last30days/intelligence.json'
+        if default_file.is_file():
+            file_path = str(default_file)
+    if file_path:
+        payload = json.loads(Path(file_path).expanduser().read_text(encoding="utf-8"))
+        if not isinstance(payload, dict) or set(payload) - set(settings):
+            raise ValueError("configuration contains unknown non-secret settings")
+        for key, value in payload.items():
+            if key in {"limits", "weights"}:
+                if not isinstance(value, dict):
+                    raise ValueError(f"{key} must be an object")
+                settings[key].update(value)
+            else:
+                settings[key] = value
+    settings["limits"] = asdict(Limits(**settings["limits"]))
+    for key in ("lookback_days", "max_reports"):
+        if type(settings[key]) is not int or settings[key] < 1:
+            raise ValueError(f"{key} must be a positive integer")
+    for key in ("threshold_a", "threshold_b", "confidence_threshold", "cache_seconds",
+                "min_delivery_interval_seconds", "source_check_interval_seconds"):
+        value = settings[key]
+        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value < 0:
+            raise ValueError(f"invalid {key}")
+    if not 0 <= settings["threshold_b"] <= settings["threshold_a"] <= 100 or settings["confidence_threshold"] > 1:
+        raise ValueError("invalid score or confidence thresholds")
+    if set(settings["weights"]) - set(DEFAULT_WEIGHTS):
+        raise ValueError("unknown score weight")
+    for value in settings["weights"].values():
+        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value < 0:
+            raise ValueError("invalid score weight")
+    if sum(settings["weights"].values()) <= 0:
+        raise ValueError("score weights need a positive sum")
+    if not isinstance(settings["channels"], list) or set(settings["channels"]) - {"webhook", "telegram", "feishu", "slack", "wecom", "smtp"}:
+        raise ValueError("unknown notification channel")
+    if not isinstance(settings["engine_sources"], list) or not all(isinstance(item, str) for item in settings["engine_sources"]):
+        raise ValueError("engine_sources must be a list")
+    ZoneInfo(settings["timezone"])
+    settings['local_proxy_url'] = validate_local_proxy_url(settings['local_proxy_url'])
+    for key, variable in (("db", "LAST30DAYS_INTEL_DB"), ("report_dir", "LAST30DAYS_INTEL_REPORT_DIR")):
+        if os.environ.get(variable):
+            settings[key] = os.environ[variable]
+        if not isinstance(settings[key], str) or not settings[key].strip():
+            raise ValueError(f"invalid {key}")
+    return settings
diff --git a/skills/last30days/scripts/lib/intelligence/delivery.py b/skills/last30days/scripts/lib/intelligence/delivery.py
new file mode 100644
index 0000000..403da70
--- /dev/null
+++ b/skills/last30days/scripts/lib/intelligence/delivery.py
@@ -0,0 +1,612 @@
+"""Evidence cards and a durable, credential-free notification outbox (stdlib).
+
+Enable channels with LAST30DAYS_INTEL_CHANNELS=telegram,feishu,webhook,slack,
+wecom,smtp. Credentials are read only from the supplied environment mapping (or
+os.environ); this module never reads upstream SQLite settings or .env files.
+All following names have the LAST30DAYS_INTEL_ prefix:
+
+* TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
+* FEISHU_WEBHOOK_URL, optional FEISHU_SECRET (custom-bot signing secret)
+* SLACK_WEBHOOK_URL, WECOM_WEBHOOK_URL
+* WEBHOOK_URL, optional WEBHOOK_TOKEN (Bearer authentication)
+* SMTP_HOST, SMTP_PORT (465 by default), SMTP_FROM, SMTP_TO (comma-separated),
+  SMTP_USERNAME, SMTP_PASSWORD, SMTP_TLS (ssl by default, or starttls)
+
+init_schema/enqueue preserve an existing caller transaction. The caller must
+commit it before an actual flush: leases, rate reservations and acknowledgments
+must become durable before network I/O. A flush never sleeps waiting for a rate
+limit or retry; another scheduled invocation processes jobs when they are due.
+
+Delivery is at-least-once. Each acknowledged chunk is saved, but a remote send
+whose acknowledgment is lost can repeat after a crash. Generic webhooks receive
+a stable per-chunk idempotency key in both their body and Idempotency-Key header.
+HTTP uses inherited proxies and verified TLS; redirects are rejected. SMTP uses
+verified implicit TLS or STARTTLS, through the ordinary SMTP socket transport.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import hmac
+import json
+import math
+import os
+import re
+import smtplib
+import sqlite3
+import ssl
+import time
+import urllib.error
+import urllib.request
+import uuid
+from contextlib import contextmanager
+from email.message import EmailMessage
+from email.utils import parseaddr
+from typing import Callable, Mapping
+from urllib.parse import urlsplit
+
+
+CHANNELS = frozenset({"telegram", "feishu", "slack", "wecom", "webhook", "smtp"})
+ENV_KEYS = frozenset("LAST30DAYS_INTEL_" + suffix for suffix in (
+    "CHANNELS", "TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID", "FEISHU_WEBHOOK_URL", "FEISHU_SECRET",
+    "SLACK_WEBHOOK_URL", "WECOM_WEBHOOK_URL", "WEBHOOK_URL", "WEBHOOK_TOKEN", "SMTP_HOST", "SMTP_PORT",
+    "SMTP_FROM", "SMTP_TO", "SMTP_USERNAME", "SMTP_PASSWORD", "SMTP_TLS",
+))
+LEASE_SECONDS = 120.0
+HTTP_TIMEOUT_SECONDS = 20.0
+_MAX_RESPONSE_BYTES = 65536
+_SAFE_ERRORS = frozenset({
+    "invalid_config", "invalid_report", "invalid_options", "transaction_pending",
+    "platform_rejected", "smtp_rejected", "http_error", "network_error",
+    "redirect_rejected", "sender_error", "lease_expired",
+})
+# Conservative text limits reserve space for wrappers and continuation headings.
+_TEXT_LIMITS = {"telegram": 4000, "feishu": 8000, "slack": 2800,
+                "wecom": 1900, "webhook": 16000, "smtp": 64000}
+
+
+class DeliveryError(Exception):
+    """An intentionally bounded error: no transport message or URL is retained."""
+
+    def __init__(self, code: str):
+        self.code = code if code in _SAFE_ERRORS else "sender_error"
+        super().__init__(self.code)
+
+
+class ChannelConfig(dict):
+    """Runtime credentials, with a safe repr even inside an outer config dict."""
+
+    def __repr__(self) -> str:
+        return "ChannelConfig(<redacted>)"
+
+    __str__ = __repr__
+
+
+def load_channels(environ: Mapping[str, str] | None = None) -> dict[str, dict]:
+    """Load explicitly enabled channels; missing credentials stay unconfigured.
+
+    Dry-run previews need no credentials. Actual sends with incomplete settings
+    fail with invalid_config, without exposing the supplied values.
+    """
+    env = os.environ if environ is None else environ
+    names = [item.strip().lower() for item in env.get("LAST30DAYS_INTEL_CHANNELS", "").split(",") if item.strip()]
+    if any(name not in CHANNELS for name in names):
+        raise DeliveryError("invalid_config")
+
+    def value(suffix: str, default: str = "") -> str:
+        return env.get("LAST30DAYS_INTEL_" + suffix, default)
+
+    result: dict[str, dict] = {}
+    for name in names:
+        if name == "telegram":
+            config = {"bot_token": value("TELEGRAM_BOT_TOKEN"), "chat_id": value("TELEGRAM_CHAT_ID")}
+        elif name == "smtp":
+            tls = value("SMTP_TLS", "ssl").lower()
+            config = {"host": value("SMTP_HOST"), "port": value("SMTP_PORT", "587" if tls == "starttls" else "465"),
+                      "tls": tls, "from": value("SMTP_FROM"),
+                      "to": [part.strip() for part in value("SMTP_TO").split(",") if part.strip()],
+                      "username": value("SMTP_USERNAME"), "password": value("SMTP_PASSWORD")}
+        else:
+            suffix = "WEBHOOK_URL" if name == "webhook" else name.upper() + "_WEBHOOK_URL"
+            config = {"webhook_url": value(suffix)}
+            if name == "webhook":
+                config["token"] = value("WEBHOOK_TOKEN")
+            elif name == "feishu":
+                config["signing_secret"] = value("FEISHU_SECRET")
+        result[name] = ChannelConfig(config)
+    return result
+
+
+def init_schema(conn: sqlite3.Connection) -> None:
+    """Add intelligence tables without changing upstream schema/user_version.
+
+    Individual statements intentionally avoid executescript's implicit commit.
+    """
+    statements = (
+        """CREATE TABLE IF NOT EXISTS intel_outbox (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            event_id TEXT NOT NULL, revision TEXT NOT NULL,
+            channel TEXT NOT NULL, tier TEXT NOT NULL, period_key TEXT NOT NULL,
+            report_json TEXT NOT NULL, chunks_json TEXT NOT NULL,
+            total_chunks INTEGER NOT NULL, next_chunk INTEGER NOT NULL DEFAULT 0,
+            status TEXT NOT NULL DEFAULT 'pending', attempts INTEGER NOT NULL DEFAULT 0,
+            next_attempt_at REAL NOT NULL DEFAULT 0,
+            lease_token TEXT, lease_until REAL,
+            created_at REAL NOT NULL, updated_at REAL NOT NULL, sent_at REAL,
+            last_error TEXT,
+            UNIQUE(event_id, revision, channel, tier, period_key)
+        )""",
+        """CREATE INDEX IF NOT EXISTS intel_outbox_due
+            ON intel_outbox(status, next_attempt_at, channel)""",
+        """CREATE TABLE IF NOT EXISTS intel_delivery_log (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            outbox_id INTEGER NOT NULL REFERENCES intel_outbox(id),
+            channel TEXT NOT NULL, chunk_index INTEGER NOT NULL,
+            attempt INTEGER NOT NULL, outcome TEXT NOT NULL,
+            attempted_at REAL NOT NULL, error_code TEXT,
+            idempotency_key TEXT NOT NULL
+        )""",
+        """CREATE TABLE IF NOT EXISTS intel_delivery_rate_limits (
+            channel TEXT PRIMARY KEY, next_send_at REAL NOT NULL
+        )""",
+    )
+    for statement in statements:
+        conn.execute(statement)
+
+
+@contextmanager
+def _savepoint(conn: sqlite3.Connection):
+    name = "intel_" + uuid.uuid4().hex
+    conn.execute("SAVEPOINT " + name)
+    try:
+        yield
+        conn.execute("RELEASE SAVEPOINT " + name)
+    except BaseException:
+        conn.execute("ROLLBACK TO SAVEPOINT " + name)
+        conn.execute("RELEASE SAVEPOINT " + name)
+        raise
+
+
+@contextmanager
+def _atomic(conn: sqlite3.Connection):
+    # This write lock is held only for queue bookkeeping, never during I/O.
+    conn.execute("BEGIN IMMEDIATE")
+    try:
+        yield
+        conn.commit()
+    except BaseException:
+        conn.rollback()
+        raise
+
+
+def _json(value) -> str:
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def _display(value, default: str = "unknown") -> str:
+    if value is None or value == "" or value == [] or value == {}:
+        return default
+    return _json(value) if isinstance(value, (dict, list)) else str(value)
+
+
+def _card(report: dict, tier: str, period_key: str) -> str:
+    kind = {"A": "A intelligence alert", "B": "B daily digest", "C": "C weekly synthesis"}[tier]
+    lines = [kind + (" | " + period_key if period_key else ""),
+             _display(report.get("title")), _display(report.get("summary")),
+             "Event: " + _display(report.get("id")) + " | Revision: " + _display(report.get("revision")),
+             "Domain: " + _display(report.get("domain")),
+             "Verification: " + _display(report.get("verification_status")), "Source roles:"]
+    trace = report.get("source_trace") or {}
+    lines.append("Earliest verifiable retrieved record (observed graph): " + _display(trace.get("earliest_verifiable")))
+    lines.append("Creator direct: " + _display(trace.get("creator_direct")))
+    lines.append("Underlying evidence: " + _display(trace.get("underlying_evidence")))
+    lines.append("Origin: " + _display(trace.get("origin_status")))
+    lines.append("Evidence:")
+    for index, evidence in enumerate(report.get("evidence") or [], 1):
+        lines.append(str(index) + ". " + _display(evidence.get("url")))
+        lines.append("Status: " + _display(evidence.get("status")) + " | Author: " + _display(evidence.get("author"))
+                     + " | Published: " + _display(evidence.get("published_at")) + " | Version: "
+                     + _display(evidence.get("version")) + " | Resource: " + _display(evidence.get("resource_type")))
+        lines.append("Quote: " + _display(evidence.get("quote")))
+        lines.append("Locator: " + _display(evidence.get("locator")) + " | Hash: " + _display(evidence.get("content_hash"))
+                     + " | Verified at: " + _display(evidence.get("verified_at")))
+    lines.append("Claims (status retained): " + _display(report.get("claims")))
+    analysis = report.get("analysis") or {}
+    for key, label in (("new", "New"), ("why_it_matters", "Why it matters"),
+                       ("application_potential", "Application potential (hypothesis)"),
+                       ("uncertainty", "Uncertainty"), ("inferences", "AI inferences (not verified)")):
+        lines.append(label + ": " + _display(analysis.get(key)))
+    score = report.get("score") or {}
+    lines.append("Score (heuristic proxy; not proof of innovation): " + _display(score.get("total")))
+    lines.append("Score components: " + _display(score.get("components")) + " | Method: " + _display(score.get("method")))
+    if report.get("report_url"):
+        # Only a caller-supplied, externally verified URL; no synthetic links.
+        lines.append("Full report: " + str(report["report_url"]))
+    lines.append("Generated: " + _display(report.get("generated_at")))
+    return "\n".join(lines)
+
+
+def _chunks(text: str, channel: str) -> list[str]:
+    limit = _TEXT_LIMITS[channel] - 80
+    encoding = "utf-16-le" if channel == "telegram" else "utf-8"
+    divisor = 2 if channel == "telegram" else 1
+    parts = []
+    offset = 0
+    while offset < len(text):
+        size, end = 0, offset
+        while end < len(text):
+            # Feishu limits the JSON message body, where control characters can
+            # expand sixfold. Its conservative limit includes escaped text.
+            units = (len(_json(text[end])[1:-1].encode("utf-8")) if channel == "feishu"
+                     else len(text[end].encode(encoding)) // divisor)
+            if size + units > limit:
+                break
+            size += units
+            end += 1
+        if end < len(text):
+            newline = text.rfind("\n", offset, end)
+            if newline > offset + (end - offset) // 2:
+                end = newline + 1
+        parts.append(text[offset:end])
+        offset = end
+    total = len(parts)
+    return [f"[last30days {index}/{total}]\n" + part for index, part in enumerate(parts, 1)]
+
+
+def enqueue(conn: sqlite3.Connection, report: dict, channel: str, tier: str = "A", period_key: str = "") -> bool:
+    """Persist a report once per event/revision/channel/tier/period; False on duplicates/hold."""
+    if not isinstance(report, dict):
+        raise DeliveryError("invalid_report")
+    if report.get("tier") == "hold" or tier == "hold":
+        return False
+    if channel not in CHANNELS or tier not in {"A", "B", "C"} or not isinstance(period_key, str):
+        raise DeliveryError("invalid_config")
+    if not all(isinstance(report.get(key), str) and report[key].strip() for key in ("id", "revision")):
+        raise DeliveryError("invalid_report")
+    try:
+        serialized = _json(report)
+        chunks = _chunks(_card(report, tier, period_key), channel)
+    except (TypeError, ValueError, AttributeError, UnicodeError):
+        raise DeliveryError("invalid_report") from None
+    init_schema(conn)
+    created = time.time()
+    with _savepoint(conn):
+        cursor = conn.execute("""INSERT INTO intel_outbox
+            (event_id,revision,channel,tier,period_key,report_json,chunks_json,total_chunks,created_at,updated_at)
+            VALUES (?,?,?,?,?,?,?,?,?,?)
+            ON CONFLICT(event_id,revision,channel,tier,period_key) DO NOTHING""",
+            (report["id"], report["revision"], channel, tier, period_key, serialized, _json(chunks), len(chunks), created, created))
+    return cursor.rowcount == 1
+
+
+def _rows(cursor) -> list[dict]:
+    names = [column[0] for column in cursor.description]
+    return [dict(zip(names, row)) for row in cursor.fetchall()]
+
+
+def _delivery_key(job: dict, index: int) -> str:
+    identity = [job[key] for key in ("event_id", "revision", "channel", "tier", "period_key")] + [index]
+    return hashlib.sha256(_json(identity).encode("utf-8")).hexdigest()
+
+
+def _payload(job: dict, report: dict, text: str, index: int, config: dict, preview: bool = False) -> dict:
+    channel = job["channel"]
+    if channel == "telegram":
+        return {"chat_id": "<redacted>" if preview else config.get("chat_id", ""), "text": text,
+                "link_preview_options": {"is_disabled": True}}
+    if channel == "feishu":
+        return {"msg_type": "post", "content": {"post": {"en_us": {
+            "title": f"last30days {job['tier']} {index + 1}/{job['total_chunks']}",
+            "content": [[{"tag": "text", "text": text}]]}}}}
+    if channel == "slack":
+        return {"text": text, "blocks": [{"type": "section", "text": {"type": "plain_text", "text": text}}],
+                "unfurl_links": False, "unfurl_media": False}
+    if channel == "wecom":
+        return {"msgtype": "text", "text": {"content": text}}
+    if channel == "smtp":
+        title = str(report.get("title") or "Intelligence report").replace("\r", " ").replace("\n", " ")[:180]
+        return {"subject": f"[last30days {job['tier']} {index + 1}/{job['total_chunks']}] {title}", "body": text}
+    return {"source": "last30days", "kind": "source_intelligence", "event_id": job["event_id"],
+            "revision": job["revision"], "tier": job["tier"], "period_key": job["period_key"],
+            "idempotency_key": _delivery_key(job, index),
+            "chunk": {"index": index, "count": job["total_chunks"]}, "text": text, "report": report}
+
+
+def _log(conn: sqlite3.Connection, job: dict, index: int, outcome: str, now: float, error: str | None = None):
+    conn.execute("""INSERT INTO intel_delivery_log
+        (outbox_id,channel,chunk_index,attempt,outcome,attempted_at,error_code,idempotency_key)
+        VALUES (?,?,?,?,?,?,?,?)""", (job["id"], job["channel"], index, job["attempts"], outcome, now, error,
+                                      _delivery_key(job, index)))
+
+
+def _reserve_rate(conn: sqlite3.Connection, channel: str, now: float, interval: float):
+    conn.execute("""INSERT INTO intel_delivery_rate_limits(channel,next_send_at) VALUES (?,?)
+        ON CONFLICT(channel) DO UPDATE SET next_send_at=excluded.next_send_at""", (channel, now + interval))
+
+
+def _claim(conn: sqlite3.Connection, channels: list[str], now: float, interval: float, max_attempts: int) -> dict | None:
+    with _atomic(conn):
+        conn.execute("""UPDATE intel_outbox SET status='pending',lease_token=NULL,lease_until=NULL,updated_at=?
+            WHERE status='leased' AND lease_until<=?""", (now, now))
+        conn.execute("""UPDATE intel_outbox SET status='failed',last_error='lease_expired',updated_at=?
+            WHERE status='pending' AND attempts>=?""", (now, max_attempts))
+        if not channels:
+            return None
+        placeholders = ",".join("?" for _ in channels)
+        jobs = _rows(conn.execute(f"""SELECT o.* FROM intel_outbox o
+            WHERE o.status='pending' AND o.next_attempt_at<=? AND o.channel IN ({placeholders})

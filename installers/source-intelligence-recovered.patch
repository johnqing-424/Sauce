+        slot = conn.execute("SELECT next_send_at FROM intel_delivery_rate_limits WHERE channel=?", (job["channel"],)).fetchone()
+        if slot and slot[0] > now:
+            conn.execute("""UPDATE intel_outbox SET status='pending',lease_token=NULL,lease_until=NULL,
+                next_attempt_at=?,updated_at=? WHERE id=? AND lease_token=?""", (slot[0], now, job["id"], job["lease_token"]))
+            return False
+        conn.execute("UPDATE intel_outbox SET attempts=1,lease_until=?,updated_at=? WHERE id=? AND lease_token=?",
+                     (now + LEASE_SECONDS, now, job["id"], job["lease_token"]))
+        _reserve_rate(conn, job["channel"], now, interval)
+        job["attempts"] = 1
+        return True

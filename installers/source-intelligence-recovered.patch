+ report_json TEXT NOT NULL, created_at TEXT NOT NULL, PRIMARY KEY(event_id,revision));
+CREATE TABLE IF NOT EXISTS intel_observations(
+ event_id TEXT NOT NULL REFERENCES intel_events(id), observation_key TEXT NOT NULL,
+ observation_json TEXT NOT NULL, first_seen TEXT NOT NULL, last_seen TEXT NOT NULL,
+ seen_count INTEGER NOT NULL DEFAULT 1, PRIMARY KEY(event_id,observation_key));
+CREATE TABLE IF NOT EXISTS intel_event_merges(
+ merged_event_id TEXT PRIMARY KEY, event_id TEXT NOT NULL REFERENCES intel_events(id), merged_at TEXT NOT NULL);
+CREATE TABLE IF NOT EXISTS intel_runs(
+ id INTEGER PRIMARY KEY, mode TEXT NOT NULL, domain TEXT, started_at TEXT NOT NULL,
+ finished_at TEXT, status TEXT NOT NULL, result_json TEXT);
+CREATE TABLE IF NOT EXISTS intel_watches(

+            identifiers = doc.metadata.get("html_meta", {}).get("citation_arxiv_id", [])
+            observed = _clean(identifiers[0]) if identifiers else ""
+            if observed and re.sub(r"v\d+$", "", observed) != re.sub(r"v\d+$", "", match[1]):

+ interval_seconds REAL NOT NULL, next_run REAL NOT NULL DEFAULT 0, lease_until REAL NOT NULL DEFAULT 0,
+ enabled INTEGER NOT NULL DEFAULT 1, failures INTEGER NOT NULL DEFAULT 0, last_status TEXT,
+ config_json TEXT NOT NULL DEFAULT '{}');
+CREATE INDEX IF NOT EXISTS intel_watches_due ON intel_watches(enabled,next_run,lease_until);
+CREATE INDEX IF NOT EXISTS intel_sources_due ON intel_sources(enabled,next_check);
+"""
+
+
+def encode(payload) -> str:
+    return json.dumps(payload, ensure_ascii=False, sort_keys=True, allow_nan=False)
+
+
+class Knowledge:
+    def __init__(self, path: str | Path | None = None):
+        self.path = store.ensure_private_db_files(Path(path).expanduser() if path else store.DB_PATH)
+        store.init_db(self.path)
+        with self.connection() as conn:
+            conn.executescript(SCHEMA)
+        store.ensure_private_db_files(self.path)
+

+        "LAST30DAYS_INTEL_SMTP_TO": "one@example.org, two@example.org",
+    }
+    configs = module.load_channels(environ)
+    assert configs["feishu"]["signing_secret"] == "dummy-feishu-secret"
+    assert configs["slack"]["webhook_url"] == environ["LAST30DAYS_INTEL_SLACK_WEBHOOK_URL"]
+    assert configs["wecom"]["webhook_url"] == environ["LAST30DAYS_INTEL_WECOM_WEBHOOK_URL"]
+    assert configs["smtp"]["port"] == "587"
+    assert configs["smtp"]["to"] == ["one@example.org", "two@example.org"]
+    monkeypatch.setenv("LAST30DAYS_INTEL_CHANNELS", "slack")
+    monkeypatch.setenv("LAST30DAYS_INTEL_SLACK_WEBHOOK_URL", "https://example.org/dummy-ambient-slack")
+    assert module.load_channels()["slack"]["webhook_url"].endswith("dummy-ambient-slack")
+    assert module.load_channels({}) == {}
+    with pytest.raises(module.DeliveryError, match="invalid_config"):
+        module.load_channels({"LAST30DAYS_INTEL_CHANNELS": "dummy-secret-unknown"})
+
+
+@pytest.mark.parametrize("body,status,error", [
+    (b'{"ok":true}', 429, "http_error"),
+    (b"{" + b"x" * 65536, 200, "platform_rejected"),
+    (b"not-json", 200, "platform_rejected"),
+])
+def test_bounded_platform_ack_and_http_error_handling(conn, module, report, monkeypatch, body, status, error):
+    module.enqueue(conn, report, "telegram")
+    opener = type("Opener", (), {"open": lambda self, req, timeout: FakeResponse(body, status)})()
+    monkeypatch.setattr(module.urllib.request, "build_opener", lambda *args: opener)
+    result = module.flush(conn, {"telegram": {"bot_token": "dummy-token", "chat_id": "dummy-chat"}},
+                          dry_run=False, now=100)
+    assert result["failed"] == 1 and state(conn)["last_error"] == error
+
+
+@pytest.mark.parametrize("error,expected", [
+    (urllib.error.HTTPError("https://example.org/dummy-secret", 500, "dummy-token", {}, None), "http_error"),
+    (OSError("https://example.org/dummy-secret dummy-token"), "network_error"),
+])
+def test_transport_errors_have_bounded_secret_free_public_repr(conn, module, report, monkeypatch, error, expected):
+    module.enqueue(conn, report, "webhook")
+    class Opener:
+        def open(self, req, timeout):
+            raise error
+    monkeypatch.setattr(module.urllib.request, "build_opener", lambda *args: Opener())
+    result = module.flush(conn, {"webhook": {"webhook_url": "https://example.org/dummy-secret"}}, dry_run=False, now=100)
+    assert result["failed"] == 1 and state(conn)["last_error"] == expected
+    assert "dummy-secret" not in "\n".join(conn.iterdump())
+    assert "dummy-token" not in repr(module.DeliveryError("dummy-token"))
+
+
+def test_smtp_implicit_tls_can_deliver_without_storing_addresses(conn, module, report, monkeypatch):
+    module.enqueue(conn, report, "smtp")
+    config = {"host": "smtp.example.org", "from": "sender@example.org", "to": "receiver@example.org"}
+    messages = []
+    class SMTPSSL:
+        def __init__(self, host, port, timeout, context):
+            assert host == "smtp.example.org" and port == 465
+            assert context.check_hostname
+        def __enter__(self):
+            return self
+        def __exit__(self, *args):
+            return False
+        def send_message(self, message):
+            messages.append(message)
+            return {}
+    monkeypatch.setattr(module.smtplib, "SMTP_SSL", SMTPSSL)
+    result = module.flush(conn, {"smtp": config}, dry_run=False, now=100)
+    assert result["sent"] == 1
+    assert messages[0]["To"] == "receiver@example.org"
+    assert "receiver@example.org" not in "\n".join(conn.iterdump())
+
+
+@pytest.mark.parametrize("override", [
+    {"tls": "plain"}, {"port": 0}, {"port": "dummy-secret-port"},
+    {"from": "sender@example.org\r\nBcc: injected@example.org"},
+    {"to": []}, {"to": "invalid-address"}, {"username": "dummy-user"},
+])
+def test_invalid_smtp_settings_never_open_transport(conn, module, report, monkeypatch, override):
+    module.enqueue(conn, report, "smtp")
+    monkeypatch.setattr(module.smtplib, "SMTP_SSL", lambda *args, **kwargs: pytest.fail("invalid SMTP settings opened a socket"))
+    config = {"host": "smtp.example.org", "from": "sender@example.org", "to": ["receiver@example.org"], **override}
+    result = module.flush(conn, {"smtp": config}, dry_run=False, now=100)
+    assert result["failed"] == 1 and state(conn)["last_error"] == "invalid_config"
+
+
+@pytest.mark.parametrize("report_override,channel,tier", [
+    ({"id": ""}, "webhook", "A"), ({"revision": None}, "webhook", "A"),
+    ({"source_trace": "bad-shape"}, "webhook", "A"), ({"score": {"total": float("nan")}}, "webhook", "A"),
+    ({}, "unknown", "A"), ({}, "webhook", "unknown"),
+])
+def test_invalid_report_or_route_cannot_enter_outbox(conn, module, report, report_override, channel, tier):
+    with pytest.raises(module.DeliveryError):
+        module.enqueue(conn, dict(report, **report_override), channel, tier)
+    assert conn.execute("SELECT COUNT(*) FROM intel_outbox").fetchone()[0] == 0
+
+
+@pytest.mark.parametrize("options", [
+    {"max_attempts": 0}, {"min_interval_seconds": -1}, {"min_interval_seconds": float("inf")},
+    {"now": float("nan")},
+])
+def test_invalid_flush_options_are_rejected_before_sends(conn, module, report, options):
+    module.enqueue(conn, report, "webhook")
+    with pytest.raises(module.DeliveryError, match="invalid_options"):
+        module.flush(conn, {"webhook": {}}, dry_run=False, **options)
+
+
+def test_feishu_chunks_fit_json_message_limit_even_when_quotes_need_escaping(conn, module, report):
+    report["summary"] = "\x01" * 5000
+    module.enqueue(conn, report, "feishu")
+    previews = module.flush(conn, {}, now=100)["previews"]
+    assert len(previews) > 1
+    for preview in previews:
+        body = json.dumps(preview["payload"], ensure_ascii=False).encode("utf-8")
+        assert len(body) < 20000
+    assert sum(text_of("feishu", preview["payload"]).count("\x01") for preview in previews) == 5000

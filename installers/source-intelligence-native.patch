+class Fallback:
+    last_failures = [{"source": "simulated", "status": "unavailable"}]
+
+    def fetch(self, url, budget):
+        budget.take()
+        return Document(url=url, text="Fallback source snapshot.")
+
+    def discover(self, domain, budget, since, limit=8):

+def _chunks(text: str, channel: str) -> list[str]:
+    limit = _TEXT_LIMITS[channel] - 80
+    encoding = "utf-16-le" if channel == "telegram" else "utf-8"
+    divisor = 2 if channel == "telegram" else 1
+    parts = []
+    offset = 0
+    while offset < len(text):
+        size, end = 0, offset
+        while end < len(text):
+            # Feishu limits the JSON message body, where control characters can
+            # expand sixfold. Its conservative limit includes escaped text.
+            units = (len(_json(text[end])[1:-1].encode("utf-8")) if channel == "feishu"
+                     else len(text[end].encode(encoding)) // divisor)
+            if size + units > limit:
+                break
+            size += units
+            end += 1
+        if end < len(text):
+            newline = text.rfind("\n", offset, end)
+            if newline > offset + (end - offset) // 2:
+                end = newline + 1
+        parts.append(text[offset:end])
+        offset = end
+    total = len(parts)
+    return [f"[last30days {index}/{total}]\n" + part for index, part in enumerate(parts, 1)]

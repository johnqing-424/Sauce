@@ -0,0 +1,659 @@
+"""Evidence cards and a durable, credential-free notification outbox (stdlib).
+
+Enable channels with LAST30DAYS_INTEL_CHANNELS=telegram,feishu,webhook,slack,
+wecom,smtp. Credentials are read only from the supplied environment mapping (or
+os.environ); this module never reads upstream SQLite settings or .env files.
+All following names have the LAST30DAYS_INTEL_ prefix:
+
+* TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
+* FEISHU_WEBHOOK_URL, optional FEISHU_SECRET (custom-bot signing secret)
+* SLACK_WEBHOOK_URL, WECOM_WEBHOOK_URL
+* WEBHOOK_URL, optional WEBHOOK_TOKEN (Bearer authentication)
+* SMTP_HOST, SMTP_PORT (465 by default), SMTP_FROM, SMTP_TO (comma-separated),
+  SMTP_USERNAME, SMTP_PASSWORD, SMTP_TLS (ssl by default, or starttls)
+
+init_schema/enqueue preserve an existing caller transaction. The caller must
+commit it before an actual flush: leases, rate reservations and acknowledgments
+must become durable before network I/O. A flush never sleeps waiting for a rate
+limit or retry; another scheduled invocation processes jobs when they are due.
+
+Delivery is at-least-once. Each acknowledged chunk is saved, but a remote send
+whose acknowledgment is lost can repeat after a crash. Generic webhooks receive
+a stable per-chunk idempotency key in both their body and Idempotency-Key header.
+HTTP uses inherited proxies and verified TLS; redirects are rejected. SMTP uses
+verified implicit TLS or STARTTLS, through the ordinary SMTP socket transport.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import hmac
+import json
+import math
+import os
+import re
+import smtplib
+import sqlite3
+import ssl
+import time
+import urllib.error
+import urllib.request
+import uuid
+from contextlib import contextmanager
+from email.message import EmailMessage
+from email.utils import parseaddr
+from typing import Callable, Mapping
+from urllib.parse import urlsplit
+
+
+CHANNELS = frozenset({"telegram", "feishu", "slack", "wecom", "webhook", "smtp"})
+ENV_KEYS = frozenset("LAST30DAYS_INTEL_" + suffix for suffix in (
+    "CHANNELS", "TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID", "FEISHU_WEBHOOK_URL", "FEISHU_SECRET",
+    "SLACK_WEBHOOK_URL", "WECOM_WEBHOOK_URL", "WEBHOOK_URL", "WEBHOOK_TOKEN", "SMTP_HOST", "SMTP_PORT",
+    "SMTP_FROM", "SMTP_TO", "SMTP_USERNAME", "SMTP_PASSWORD", "SMTP_TLS",
+))
+LEASE_SECONDS = 120.0
+HTTP_TIMEOUT_SECONDS = 20.0
+_MAX_RESPONSE_BYTES = 65536
+_SAFE_ERRORS = frozenset({
+    "invalid_config", "invalid_report", "invalid_options", "transaction_pending",
+    "platform_rejected", "smtp_rejected", "http_error", "network_error",
+    "redirect_rejected", "sender_error", "lease_expired",
+})
+# Conservative text limits reserve space for wrappers and continuation headings.
+_TEXT_LIMITS = {"telegram": 4000, "feishu": 8000, "slack": 2800,
+                "wecom": 1900, "webhook": 16000, "smtp": 64000}
+
+
+class DeliveryError(Exception):
+    """An intentionally bounded error: no transport message or URL is retained."""
+
+    def __init__(self, code: str):
+        self.code = code if code in _SAFE_ERRORS else "sender_error"
+        super().__init__(self.code)
+
+
+class ChannelConfig(dict):
+    """Runtime credentials, with a safe repr even inside an outer config dict."""
+
+    def __repr__(self) -> str:
+        return "ChannelConfig(<redacted>)"
+
+    __str__ = __repr__
+
+
+def load_channels(environ: Mapping[str, str] | None = None) -> dict[str, dict]:
+    """Load explicitly enabled channels; missing credentials stay unconfigured.
+
+    Dry-run previews need no credentials. Actual sends with incomplete settings
+    fail with invalid_config, without exposing the supplied values.
+    """
+    env = os.environ if environ is None else environ
+    names = [item.strip().lower() for item in env.get("LAST30DAYS_INTEL_CHANNELS", "").split(",") if item.strip()]
+    if any(name not in CHANNELS for name in names):
+        raise DeliveryError("invalid_config")
+
+    def value(suffix: str, default: str = "") -> str:
+        return env.get("LAST30DAYS_INTEL_" + suffix, default)
+
+    result: dict[str, dict] = {}
+    for name in names:
+        if name == "telegram":
+            config = {"bot_token": value("TELEGRAM_BOT_TOKEN"), "chat_id": value("TELEGRAM_CHAT_ID")}
+        elif name == "smtp":
+            tls = value("SMTP_TLS", "ssl").lower()
+            config = {"host": value("SMTP_HOST"), "port": value("SMTP_PORT", "587" if tls == "starttls" else "465"),
+                      "tls": tls, "from": value("SMTP_FROM"),
+                      "to": [part.strip() for part in value("SMTP_TO").split(",") if part.strip()],
+                      "username": value("SMTP_USERNAME"), "password": value("SMTP_PASSWORD")}
+        else:
+            suffix = "WEBHOOK_URL" if name == "webhook" else name.upper() + "_WEBHOOK_URL"
+            config = {"webhook_url": value(suffix)}
+            if name == "webhook":
+                config["token"] = value("WEBHOOK_TOKEN")
+            elif name == "feishu":
+                config["signing_secret"] = value("FEISHU_SECRET")
+        result[name] = ChannelConfig(config)
+    return result
+
+
+def init_schema(conn: sqlite3.Connection) -> None:
+    """Add intelligence tables without changing upstream schema/user_version.
+
+    Individual statements intentionally avoid executescript's implicit commit.
+    """
+    statements = (
+        """CREATE TABLE IF NOT EXISTS intel_outbox (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            event_id TEXT NOT NULL, revision TEXT NOT NULL,
+            channel TEXT NOT NULL, tier TEXT NOT NULL, period_key TEXT NOT NULL,
+            report_json TEXT NOT NULL, chunks_json TEXT NOT NULL,
+            total_chunks INTEGER NOT NULL, next_chunk INTEGER NOT NULL DEFAULT 0,
+            status TEXT NOT NULL DEFAULT 'pending', attempts INTEGER NOT NULL DEFAULT 0,
+            next_attempt_at REAL NOT NULL DEFAULT 0,
+            lease_token TEXT, lease_until REAL,
+            created_at REAL NOT NULL, updated_at REAL NOT NULL, sent_at REAL,
+            last_error TEXT,
+            UNIQUE(event_id, revision, channel, tier, period_key)
+        )""",
+        """CREATE INDEX IF NOT EXISTS intel_outbox_due
+            ON intel_outbox(status, next_attempt_at, channel)""",
+        """CREATE TABLE IF NOT EXISTS intel_delivery_log (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            outbox_id INTEGER NOT NULL REFERENCES intel_outbox(id),
+            channel TEXT NOT NULL, chunk_index INTEGER NOT NULL,
+            attempt INTEGER NOT NULL, outcome TEXT NOT NULL,
+            attempted_at REAL NOT NULL, error_code TEXT,
+            idempotency_key TEXT NOT NULL
+        )""",
+        """CREATE TABLE IF NOT EXISTS intel_delivery_rate_limits (
+            channel TEXT PRIMARY KEY, next_send_at REAL NOT NULL
+        )""",
+    )
+    for statement in statements:
+        conn.execute(statement)
+
+
+@contextmanager
+def _savepoint(conn: sqlite3.Connection):
+    name = "intel_" + uuid.uuid4().hex
+    conn.execute("SAVEPOINT " + name)
+    try:
+        yield
+        conn.execute("RELEASE SAVEPOINT " + name)
+    except BaseException:
+        conn.execute("ROLLBACK TO SAVEPOINT " + name)
+        conn.execute("RELEASE SAVEPOINT " + name)
+        raise
+
+
+@contextmanager
+def _atomic(conn: sqlite3.Connection):
+    # This write lock is held only for queue bookkeeping, never during I/O.
+    conn.execute("BEGIN IMMEDIATE")
+    try:
+        yield
+        conn.commit()
+    except BaseException:
+        conn.rollback()
+        raise
+
+
+def _json(value) -> str:
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def _display(value, default: str = "unknown") -> str:
+    if value is None or value == "" or value == [] or value == {}:
+        return default
+    return _json(value) if isinstance(value, (dict, list)) else str(value)
+
+
+def has_completed_agent_review(report: dict) -> bool:
+    """Recognize all six fields and normalized citations from validated analysis.
+
+    Exact snapshot matching belongs to add_agent_analysis. A status label or
+    legacy insights alone must not qualify a report for a new A notification.
+    """
+    analysis = report.get("analysis")
+    if not isinstance(analysis, dict) or analysis.get("status") != "evidence_linked_agent_review":
+        return False
+    assessment = analysis.get("agent_assessment")
+    required = {"finding", "new", "why_it_matters", "application_potential", "limitations", "next_steps"}
+    if not isinstance(assessment, dict) or set(assessment) != required:
+        return False
+    for item in assessment.values():
+        if (not isinstance(item, dict) or item.get("status") != "ai_inference"
+                or not isinstance(item.get("text"), str) or not item["text"].strip()
+                or not isinstance(item.get("evidence"), list) or not item["evidence"]):
+            return False
+        for reference in item["evidence"]:
+            if not isinstance(reference, dict) or not all(
+                isinstance(reference.get(key), str) and reference[key].strip()
+                for key in ("url", "quote", "content_hash", "verified_at")
+            ):
+                return False
+    return True
+
+
+def _card(report: dict, tier: str, period_key: str) -> str:
+    kind = {"A": "A intelligence alert", "B": "B daily digest", "C": "C weekly synthesis"}[tier]
+    lines = [kind + (" | " + period_key if period_key else ""),
+             _display(report.get("title")), _display(report.get("summary")),
+             "Event: " + _display(report.get("id")) + " | Revision: " + _display(report.get("revision")),
+             "Domain: " + _display(report.get("domain")),
+             "Verification: " + _display(report.get("verification_status")), "Source roles:"]
+    trace = report.get("source_trace") or {}
+    lines.append("Earliest verifiable retrieved record (observed graph): " + _display(trace.get("earliest_verifiable")))
+    lines.append("Creator direct: " + _display(trace.get("creator_direct")))
+    lines.append("Underlying evidence: " + _display(trace.get("underlying_evidence")))
+    lines.append("Origin: " + _display(trace.get("origin_status")))
+    lines.append("Evidence:")
+    for index, evidence in enumerate(report.get("evidence") or [], 1):
+        lines.append(str(index) + ". " + _display(evidence.get("url")))
+        lines.append("Status: " + _display(evidence.get("status")) + " | Author: " + _display(evidence.get("author"))
+                     + " | Published: " + _display(evidence.get("published_at")) + " | Version: "
+                     + _display(evidence.get("version")) + " | Resource: " + _display(evidence.get("resource_type")))
+        lines.append("Quote: " + _display(evidence.get("quote")))
+        lines.append("Locator: " + _display(evidence.get("locator")) + " | Hash: " + _display(evidence.get("content_hash"))
+                     + " | Verified at: " + _display(evidence.get("verified_at")))
+    lines.append("Claims (status retained): " + _display(report.get("claims")))
+    analysis = report.get("analysis") or {}
+    lines.append("Agent review: " + _display(analysis.get("status"), "agent_review_required"))
+    for key, label in (("new", "New"), ("why_it_matters", "Why it matters"),
+                       ("application_potential", "Application potential (hypothesis)"),
+                       ("uncertainty", "Uncertainty"), ("inferences", "AI inferences (not verified)")):
+        lines.append(label + ": " + _display(analysis.get(key)))
+    if analysis.get("next_steps"):
+        lines.append("Next steps: " + _display(analysis["next_steps"]))
+    score = report.get("score") or {}
+    lines.append("Score (heuristic proxy; not proof of innovation): " + _display(score.get("total")))
+    lines.append("Score components: " + _display(score.get("components")) + " | Method: " + _display(score.get("method")))
+    if report.get("report_url"):

+@pytest.mark.parametrize("url", ["https://raw.githubusercontent.com/simulated/tool/main/../../other/tool/README.md", "https://raw.githubusercontent.com/simulated/tool/main/%2e%2e/%2e%2e/other/tool/README.md"])

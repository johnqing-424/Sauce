+"""Discover, preserve, monitor and deliver using the extension's shared state."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import time
+from collections import Counter
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+from . import delivery
+from .analysis import AgentAnalysisError
+from .discovery import SharedBudgetSlice, fair_budget, research_handoff, triage_candidates, validate_plan
+from .engine import upstream_discover
+from .knowledge import Knowledge
+from .models import Budget, BudgetExceeded, Limits, identity_url, normalize_url, utc_now
+from .reports import save_report, save_research_brief
+from .runner import Runner
+
+
+class IntelligenceService:
+    def __init__(self, settings: dict, *, resolver=None, engine_fn=None):
+        if resolver is None:
+            from .sources import SourceResolver
+            from .transport import PublicTransport
+            resolver = SourceResolver(PublicTransport(local_proxy_url=settings.get('local_proxy_url')))
+        self.settings = settings
+        self.knowledge = Knowledge(settings["db"])
+        self.resolver = resolver
+        self.engine_fn = engine_fn or upstream_discover
+        self.limits = Limits(**settings["limits"])
+        self.runner = Runner(self.knowledge, resolver, self.limits, weights=settings["weights"],
+                             threshold_a=settings["threshold_a"], threshold_b=settings["threshold_b"],
+                             confidence_threshold=settings["confidence_threshold"], cache_seconds=settings["cache_seconds"])
+        self.configs = delivery.load_channels()
+        if settings["channels"]:
+            self.configs = {key: value for key, value in self.configs.items() if key in settings["channels"]}
+        with self.knowledge.connection() as conn:
+            delivery.init_schema(conn)
+
+    def _queue(self, report: dict, tier: str, *, period_key: str = "") -> int:
+        if tier == "A" and not delivery.has_completed_agent_review(report):
+            return 0
+        with self.knowledge.connection() as conn:
+            conn.execute("BEGIN IMMEDIATE")
+            queued = 0
+            for name in self.configs:
+                if tier in {"B", "C"} and conn.execute(
+                    "SELECT 1 FROM intel_outbox WHERE channel=? AND tier=? AND period_key=? LIMIT 1",
+                    (name, tier, period_key),
+                ).fetchone():
+                    continue
+                queued += delivery.enqueue(conn, report, name, tier, period_key)
+            return queued
+
+    def deliver(self, *, send: bool = False) -> dict:
+        with self.knowledge.connection() as conn:
+            return delivery.flush(conn, self.configs, dry_run=not send,
+                                  min_interval_seconds=self.settings["min_delivery_interval_seconds"])
+
+    def trace(self, candidate: dict | str, *, refresh: bool = False, budget: Budget | None = None,
+              domain: str = "", analysis: dict | None = None) -> dict:
+        report = self.runner.trace(candidate, refresh=refresh, budget=budget, domain=domain, agent_analysis=analysis)
+        save_report(report, self.settings["report_dir"])
+        current_primary = any(
+            resource["url"] in report["source_trace"]["creator_direct"]
+            and resource["metadata"].get("freshness_status") != "historical_not_revalidated"
+            and not resource["metadata"].get("retrieval_failures")
+            for resource in report["resources"]
+        )
+        if report["tier"] == "A" and current_primary:
+            self._queue(report, "A")
+        return report
+
+    def discover(self, domain: str, *, send: bool = False, seeds: dict | list | None = None,
+                 collect_only: bool = False, plan: dict | None = None, native_search: bool = False,
+                 analyses: dict | None = None) -> dict:
+        domain = " ".join(domain.split())
+        if not domain:
+            raise ValueError("discover requires a nonempty domain")
+        if collect_only and send:
+            raise ValueError("collect-only cannot send notifications")
+        if seeds is not None and plan is not None:
+            raise ValueError("discovery plan cannot be combined with imported seeds")
+        if native_search and (not collect_only or seeds is not None):
+            raise ValueError("native-search requires collect-only without imported seeds")
+        if seeds is None and getattr(self.resolver, "allow_fallback", True) is False:
+            raise ValueError("host-only discovery requires selected seeds")
+        if analyses is not None:
+            if seeds is None or collect_only or not isinstance(analyses, dict) or not 1 <= len(analyses) <= self.settings["max_reports"]:
+                raise ValueError("analyses require a bounded selected seed bundle, not collection-only")
+            if len(json.dumps(analyses, ensure_ascii=False, allow_nan=False).encode()) > 262144:
+                raise ValueError("analysis bundle exceeds 256 KiB")
+            analyses = {identity_url(key): value for key, value in analyses.items()}
+        plan = validate_plan(plan, domain)
+        budget = Budget(self.limits)
+        run_id = self.knowledge.start_run("discover", domain)
+        upstream = {}
+        failures, candidates, reports, collection_queries = [], [], [], []
+        historical = self.knowledge.sources(domain=domain, limit=2)
+        try:
+            if seeds is None:
+                try:
+                    upstream = self.engine_fn(domain, budget, sources=self.settings["engine_sources"], lookback_days=self.settings["lookback_days"])
+                except BudgetExceeded as exc:
+                    failures.append({"source": "last30days", "status": "budget_exhausted", "reason": str(exc)})
+                except Exception as exc:
+                    failures.append({"source": "last30days", "status": "error", "reason": type(exc).__name__})
+            else:
+                upstream = _import_seeds(seeds)
+            # Known creators are re-used as entry points. Leave room for new clues.
+            for source in historical[:1] if seeds is None else []:
+                candidates.append({"url": source["url"], "source": "historical_primary", "title": source["url"]})
+            if seeds is None:
+                queries = plan["queries"] if plan else [{"query": domain, "rationale": "Collect recent primary artifacts for the requested domain."}]
+                since = (datetime.now(timezone.utc) - timedelta(days=self.settings["lookback_days"])).date().isoformat()
+                # The resolver uses at most two API calls per query today. Reserve
+                # at least half the remaining calls and most time for tracing;
+                # collection-only has no trace work to reserve. Every query still
+                # receives a slice of that one shared collection allowance.
+                calls_left = max(0, self.limits.max_calls - budget.calls)
+                collection_budget = SharedBudgetSlice(
+                    budget, max_calls=min(len(queries) * 2, calls_left if collect_only else calls_left // 2),
+                    max_nodes=self.limits.max_nodes,
+                    max_seconds=budget.remaining_seconds * (1 if collect_only else .35),
+                )
+                for index, query in enumerate(queries):
+                    if native_search:
+                        collection_queries.append(dict(query, status="host_search_pending", candidate_count=0))
+                        continue
+                    query_budget = fair_budget(collection_budget, len(queries) - index)
+                    query_record = dict(query, status="completed", candidate_count=0)
+                    try:
+                        discovered = self.resolver.discover(query["query"], query_budget, since,
+                                                            limit=self.settings["max_reports"] * 2,
+                                                            **({"provider_queries": query["providers"]} if "providers" in query else {}))
+                        candidates.extend(dict(row, discovery_query=query["query"], discovery_rationale=query["rationale"])
+                                          if isinstance(row, dict) else row for row in discovered)
+                        query_record["candidate_count"] = len(discovered)
+                        query_failures = list(getattr(self.resolver, "last_failures", []))
+                        failures.extend(dict(failure, query=query["query"]) for failure in query_failures)
+                        if query_failures:
+                            query_record["status"] = "partial"
+                    except BudgetExceeded as exc:
+                        query_record["status"] = "budget_exhausted"
+                        failures.append({"source": "primary_discovery", "query": query["query"],
+                                         "status": "budget_exhausted", "reason": str(exc)})
+                    except Exception as exc:
+                        query_record["status"] = "error"
+                        failures.append({"source": "primary_discovery", "query": query["query"],
+                                         "status": "error", "reason": type(exc).__name__})
+                    query_record["budget"] = query_budget.snapshot()
+                    collection_queries.append(query_record)
+            candidates.extend(upstream.get("candidates", []))
+            candidates, selection, deferred, triage_failures = triage_candidates(candidates, domain, self.settings["max_reports"])
+            failures.extend(triage_failures)
+            candidates_by_id = {candidate["candidate_id"]: candidate for candidate in candidates}
+            if analyses and set(analyses) - {candidates_by_id[row["candidate_id"]]["identity"] for row in selection}:
+                raise ValueError("analysis bundle contains an unselected resource")
+            if not collect_only:
+                for index, selected in enumerate(selection):
+                    candidate = candidates_by_id[selected["candidate_id"]]
+                    try:
+                        due = any(identity_url(item["url"]) == candidate["identity"] and item["next_check"] <= time.time()
+                                  for item in historical)
+                        report = self.trace(candidate, domain=domain, budget=fair_budget(budget, len(selection) - index), refresh=due,
+                                            analysis=(analyses or {}).get(candidate["identity"]))
+                        # Runner records the representative. Keep every other
+                        # cross-platform observation on the same event identity.
+                        representative_skipped = False
+                        for observation in candidate["observations"]:
+                            if not representative_skipped and observation.get("source") == candidate.get("source") and normalize_url(observation["url"]) == candidate["url"]:
+                                representative_skipped = True
+                                continue
+                            self.knowledge.record_observation(report["id"], observation)
+                        existing = next((item for item in reports if item["id"] == report["id"]), None)
+                        if existing is None:
+                            reports.append(report)
+                        self.knowledge.mark_source_checked(candidate["url"], interval_seconds=self.settings["source_check_interval_seconds"], failed=bool(report["failures"]))
+                        selected["trace_status"] = "partial" if report["failures"] or report["exploration"]["truncated"] else "completed"
+                    except BudgetExceeded as exc:
+                        selected["trace_status"] = "budget_exhausted"
+                        failures.append({"source": candidate.get("source", "unknown"), "status": "budget_exhausted", "reason": str(exc)})
+                    except AgentAnalysisError as exc:
+                        selected["trace_status"] = "invalid_agent_analysis"
+                        failures.append({"source": candidate.get("source", "unknown"), "status": "invalid_agent_analysis", "diagnostics": exc.diagnostics})
+                    except ValueError:
+                        selected["trace_status"] = "invalid_resource_url"
+                        failures.append({"source": candidate.get("source", "unknown"), "status": "invalid_resource_url"})
+                # A report-limit or entry-point decision does not erase already
+                # known observations. New deferred clues remain in this run's
+                # durable candidate collection for later agent-selected seeds.
+                for row in deferred:

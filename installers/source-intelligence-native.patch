+"""Simulated public-source fixtures; these tests make no live-search claims."""
+
+import base64
+import importlib
+import io
+import json
+import socket
+import sys
+import time
+from urllib.parse import parse_qs, urlsplit
+from types import SimpleNamespace
+
+import pytest
+
+
+def modules():
+    return (
+        importlib.import_module("lib.intelligence.transport"),
+        importlib.import_module("lib.intelligence.sources"),
+        importlib.import_module("lib.intelligence.models"),
+    )
+
+
+def budget(**limits):
+    _, _, models = modules()
+    return models.Budget(models.Limits(**limits))
+
+
+def response(url, data, content_type="application/json", status=200, headers=None):
+    transport, _, _ = modules()
+    body = json.dumps(data).encode() if isinstance(data, (dict, list)) else data.encode()
+    return transport.Response(url, status, {"content-type": content_type, **(headers or {})}, body)
+
+
+class SimulatedTransport:
+    """Dependency fixture with explicit responses and real operation charging."""
+
+    def __init__(self, routes):
+        self.routes = routes
+        self.requested = []
+
+    def get(self, url, scan_budget):
+        scan_budget.take()
+        self.requested.append(url)
+        value = self.routes[url]
+        if isinstance(value, Exception):
+            raise value
+        return value
+
+
+@pytest.mark.parametrize("url", [
+    "http://example.com/", "ftp://example.com/a", "https://user:pass@example.com/",
+    "https://localhost/", "https://a.localhost/", "https://metadata.google.internal/",
+    "https://169.254.169.254/", "https://127.0.0.1/", "https://[::1]/",
+    "https://10.0.0.1/", "https://100.100.100.200/", "https://[fc00::1]/",
+    "https://2130706433/", "https://127.1/", "https://example.com:22/",
+    "https://example.com/\nX-Foo: injected", "https://example.com\\@127.0.0.1/",
+])
+def test_simulated_unsafe_targets_are_denied(url):
+    transport, _, _ = modules()
+    with pytest.raises(transport.SourceError, match="denied"):
+        transport.canonical_public_url(url)
+
+
+def test_simulated_canonicalization_keeps_query_and_path():
+    transport, _, _ = modules()
+    assert transport.canonical_public_url("https://EXAMPLE.com:443/a?q=2#fragment") == "https://example.com/a?q=2"
+
+
+def test_simulated_dns_rejects_any_private_answer():
+    transport, _, _ = modules()
+    def answers(*args, **kwargs):
+        return [(socket.AF_INET, socket.SOCK_STREAM, 6, "", ("8.8.8.8", 443)),
+                (socket.AF_INET, socket.SOCK_STREAM, 6, "", ("10.1.2.3", 443))]
+    with pytest.raises(transport.SourceError, match="denied"):
+        transport.validate_public_url("https://example.com/", resolver=answers)
+
+
+def test_simulated_dns_public_answers_are_pinned():
+    transport, _, _ = modules()
+    def answers(*args, **kwargs):
+        return [(socket.AF_INET, socket.SOCK_STREAM, 6, "", ("8.8.8.8", 443))]
+    canonical, addresses = transport.validate_public_url("https://EXAMPLE.com/a", resolver=answers)
+    assert canonical == "https://example.com/a"
+    assert addresses == ["8.8.8.8"]
+
+
+def test_simulated_redirect_to_private_target_is_not_requested():
+    transport, _, _ = modules()
+    requested = []
+    def sender(url, timeout, max_bytes):
+        requested.append(url)
+        return response(url, "", "text/html", 302, {"location": "https://127.0.0.1/private"})
+    client = transport.PublicTransport(sender=sender)
+    with pytest.raises(transport.SourceError, match="denied"):
+        client.get("https://example.com/", budget())
+    assert requested == ["https://example.com/"]
+
+
+def test_simulated_each_redirect_consumes_an_operation():
+    transport, _, models = modules()
+    def sender(url, timeout, max_bytes):
+        return response(url, "", "text/html", 302, {"location": "/next"})
+    with pytest.raises(models.BudgetExceeded):
+        transport.PublicTransport(sender=sender).get("https://example.com/", budget(max_calls=1))
+
+
+def test_simulated_redirect_limit_is_explicit():
+    transport, _, _ = modules()
+    def sender(url, timeout, max_bytes):
+        return response(url, "", "text/html", 302, {"location": url + "next"})
+    with pytest.raises(transport.SourceError, match="redirect"):
+        transport.PublicTransport(sender=sender, max_redirects=1).get("https://example.com/", budget())
+
+
+@pytest.mark.parametrize("status", [401, 403, 429, 503])
+def test_simulated_http_failures_remain_explicit_and_are_not_retried(status):
+    transport, _, _ = modules()
+    def sender(url, timeout, max_bytes):
+        return response(url, "secret body", "text/html", status)
+    scan_budget = budget(max_calls=1)
+    with pytest.raises(transport.SourceError) as error:
+        transport.PublicTransport(sender=sender).get("https://example.com/", scan_budget)
+    assert error.value.status == status
+    assert "secret body" not in str(error.value)
+
+
+@pytest.mark.parametrize("content_type, body", [("application/pdf", "%PDF-1.7"), ("text/html", "x" * 17)])
+def test_simulated_unsupported_or_oversize_content_fails(content_type, body):
+    transport, _, _ = modules()
+    def sender(url, timeout, max_bytes):
+        return response(url, body, content_type)
+    with pytest.raises(transport.SourceError):
+        transport.PublicTransport(sender=sender).get("https://example.com/", budget(max_bytes=16))
+
+
+def test_simulated_slow_worker_is_killed_by_operation_deadline(monkeypatch):
+    transport, _, _ = modules()
+    original = transport.subproc.run_with_timeout
+    def stalled_worker(command, **kwargs):
+        return original([sys.executable, "-c", "import time; time.sleep(30)"], **kwargs)
+    monkeypatch.setattr(transport.subproc, "run_with_timeout", stalled_worker)
+    started = time.monotonic()
+    with pytest.raises(transport.SourceError, match="deadline"):
+        transport.PublicTransport().get("https://example.com/", budget(request_timeout=0.5, max_seconds=2))
+    assert time.monotonic() - started < 1.5

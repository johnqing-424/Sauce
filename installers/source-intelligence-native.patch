+"""Primary artifact adapters and conservative HTML/feed extraction.
+
+All provider metadata comes from a retrieved response. A document's
+``primary_basis`` describes control of the artifact, not scientific validation
+or institutional identity. External text, including instructions, stays data.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import re
+import xml.etree.ElementTree as ET
+from datetime import date, datetime
+from email.utils import parsedate_to_datetime
+from html.parser import HTMLParser
+from urllib.parse import quote, urlencode, urljoin, urlsplit, urlunsplit
+
+from .models import Budget, BudgetExceeded, Document, Link, utc_now
+from .transport import PublicTransport, Response, SourceError, canonical_public_url
+
+
+def _clean(value) -> str:
+    return re.sub(r"\s+", " ", str(value or "")).strip()
+
+
+def _date(value) -> str | None:
+    value = _clean(value)
+    if not value:
+        return None
+    try:
+        datetime.fromisoformat(value.replace("Z", "+00:00").replace("/", "-"))
+        return value.replace("/", "-")
+    except ValueError:
+        try:
+            return parsedate_to_datetime(value).isoformat()
+        except (ValueError, TypeError, OverflowError):
+            return None
+
+
+def _json(response: Response) -> dict:
+    try:
+        value = json.loads(response.text())
+    except (ValueError, TypeError):
+        raise SourceError("metadata", "invalid JSON source metadata") from None
+    if not isinstance(value, dict):
+        raise SourceError("metadata", "expected a JSON metadata object")
+    return value
+
+
+def _observed_url(value: str, base: str = "") -> str:
+    """Upgrade legacy links only for publishers with an explicit HTTPS endpoint."""
+    resolved = urljoin(base, value)
+    parts = urlsplit(resolved)
+    if parts.scheme == "http" and parts.hostname in {"arxiv.org", "export.arxiv.org", "doi.org", "dx.doi.org"}:
+        return urlunsplit(("https", parts.netloc, parts.path, parts.query, parts.fragment))
+    return resolved
+
+
+_GITHUB_SITE_ROUTES = frozenset({
+    "about", "account", "apps", "collections", "contact", "customer-stories", "enterprise",
+    "events", "explore", "features", "integrations", "issues", "login", "marketplace", "new",
+    "notifications", "orgs", "organizations", "pricing", "pulls", "search", "security", "settings",
+    "site", "solutions", "sponsors", "topics", "trending", "resources", "open-source", "signup", "join",
+})
+
+
+def _github_kind(url: str) -> str | None:
+    parts = urlsplit(url)
+    if parts.hostname not in {"github.com", "www.github.com"}:
+        return None
+    path = parts.path.strip("/").split("/")
+    if not path[0] or path[0].lower() in _GITHUB_SITE_ROUTES:
+        # Resource directories are navigation; an actual publisher article leaf
+        # remains readable evidence when its article body is present.
+        if len(path) > 2 and path[:2] in (["resources", "articles"], ["resources", "whitepapers"]):
+            return "article"
+        return "site_navigation"
+    if len(path) == 1:
+        return "author_profile"
+    if len(path) == 2:
+        if path[1].casefold().removesuffix(".git") == path[0].casefold():
+            return "author_profile"
+        return "website_repository" if path[1].lower().removesuffix(".git") == path[0].lower() + ".github.io" else "repository"
+    if path[2] in {"blob", "tree", "wiki"}:
+        return "documentation"
+    if path[2] == "releases":
+        return "release"
+    return "discussion" if path[2] in {"issues", "discussions", "pull"} else "repository_page"
+
+
+def _relation(url: str, label: str = "", default: str = "references") -> str:
+    parts = urlsplit(url)
+    if parts.hostname in {"github.com", "www.github.com"}:
+        path = parts.path.strip("/").split("/")
+        if not path[0] or path[0].lower() in _GITHUB_SITE_ROUTES:
+            return "references"
+        if len(path) == 1:
+            return "author"
+        if len(path) == 2:
+            return "code"
+        if path[2] in {"blob", "tree", "wiki"}:
+            return "documentation"
+        if path[2] == "releases":
+            return "release"
+        return "references"
+    if parts.hostname in {"doi.org", "dx.doi.org"}:
+        return "doi"
+    if parts.path.endswith(".pdf") or (parts.hostname in {"arxiv.org", "export.arxiv.org"} and parts.path.startswith("/pdf/")):
+        return "pdf"
+    if parts.hostname in {"arxiv.org", "export.arxiv.org"} and parts.path.startswith(("/abs/", "/html/")):
+        return "paper"
+    if parts.hostname == "gitlab.com" and len(parts.path.strip("/").split("/")) >= 2:
+        return "code"
+    return default
+
+
+def _link(value, base, relation="references", label="", locator="") -> Link | None:
+    if not isinstance(value, str) or not value.strip():
+        return None
+    try:
+        resolved = _observed_url(value.strip(), base)
+        parts = urlsplit(resolved)
+        if parts.scheme not in {"http", "https"} or not parts.hostname:
+            return None
+        if _github_kind(resolved) == "site_navigation" and relation not in {"canonical", "feed", "author", "organization"}:
+            return None
+    except ValueError:
+        return None
+    return Link(resolved, _relation(resolved, label, relation) if relation == "references" else relation, _clean(label), locator)
+
+
+def _plain_links(text: str, base: str, locator: str) -> list[Link]:
+    links = []
+    for match in re.finditer(r"https?://[^\s<>\"'()\[\]{}]+", text):
+        link = _link(match[0].rstrip(".,;!?"), base, locator=locator)
+        if link:
+            links.append(link)
+    return links
+
+
+def _failure(exc: Exception, source: str) -> dict:
+    if isinstance(exc, SourceError):
+        return {"source": source, **exc.to_dict()}
+    if isinstance(exc, BudgetExceeded):
+        return {"source": source, "kind": "budget_exceeded", "status": None, "message": str(exc)}
+    return {"source": source, "kind": "metadata", "status": None, "message": "source metadata could not be read"}
+
+
+def _navigation(tag: str, attrs: dict, *, in_content: bool) -> bool:
+    role = (attrs.get("role") or "").lower()
+    return tag in {"nav", "footer"} or role in {"navigation", "contentinfo"} or (
+        not in_content and (tag == "header" or role == "banner")
+    )
+
+
+class _HTML(HTMLParser):
+    _void = frozenset({"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr"})
+
+    def __init__(self, base: str):
+        super().__init__(convert_charrefs=True)
+        self.base = base
+        self.meta: dict[str, list[str]] = {}
+        self.links: list[Link] = []
+        self.chunks: list[str] = []
+        self.title: list[str] = []
+        self.jsonld: list[dict] = []
+        self._skip = 0
+        self._title = False
+        self._json = False
+        self._script: list[str] = []
+        self._anchor = None
+        self._anchors = 0
+        self._elements: list[str] = []
+        self._content_starts: list[int] = []
+        self._excluded: list[str] = []
+
+    def handle_starttag(self, tag, attrs):
+        values = dict(attrs)
+        if self._excluded:
+            if tag == self._excluded[-1]:
+                self._excluded.append(tag)
+            return
+        if _navigation(tag, values, in_content=bool(self._content_starts)):
+            self._excluded.append(tag)
+            return
+        if tag not in self._void:
+            self._elements.append(tag)
+            if tag == "article" or "markdown-body" in (values.get("class") or "").split():
+                self._content_starts.append(len(self._elements) - 1)
+        if tag in {"script", "style", "template"}:
+            self._skip += 1
+            self._json = tag == "script" and values.get("type", "").lower() == "application/ld+json"
+            self._script = []
+        elif self._skip:
+            return
+        elif tag == "title":
+            self._title = True
+        elif tag == "meta":
+            key = (values.get("name") or values.get("property") or "").strip().lower()
+            if key:
+                self.meta.setdefault(key, []).append(values.get("content") or "")
+        elif tag == "link":
+            roles = set((values.get("rel") or "").lower().split())
+            if not roles.intersection({"canonical", "alternate", "author"}) or roles.intersection({"stylesheet", "preload", "modulepreload", "icon", "apple-touch-icon", "mask-icon", "manifest", "preconnect", "dns-prefetch"}):
+                return
+            content_type = (values.get("type") or "").lower()
+            relation = "canonical" if "canonical" in roles else "author" if "author" in roles else "references"
+            if relation == "references" and content_type not in {"", "text/html", "application/xhtml+xml", "application/pdf", "application/rss+xml", "application/atom+xml", "application/xml", "text/xml"}:
+                return
+            if relation == "references" and ("rss" in content_type or "atom" in content_type):
+                relation = "feed"
+            link = _link(values.get("href"), self.base, relation, locator=f"html:line {self.getpos()[0]}, link/@href")
+            if link:
+                self.links.append(link)
+        elif tag == "a":
+            self._anchors += 1
+            relation = "author" if "author" in (values.get("rel") or "").lower().split() else "references"
+            self._anchor = (values.get("href"), [], f"html:line {self.getpos()[0]}, a[{self._anchors}]/@href", relation)
+        if not self._skip and tag in {"p", "div", "article", "section", "h1", "h2", "h3", "li", "br", "tr"}:
+            self.chunks.append("\n")
+
+    def handle_endtag(self, tag):
+        if self._excluded:
+            if tag == self._excluded[-1]:
+                self._excluded.pop()
+            return
+        for index in range(len(self._elements) - 1, -1, -1):
+            if self._elements[index] == tag:
+                del self._elements[index:]
+                while self._content_starts and self._content_starts[-1] >= index:
+                    self._content_starts.pop()
+                break
+        if tag in {"script", "style", "template"} and self._skip:
+            if tag == "script" and self._json:
+                try:
+                    data = json.loads("".join(self._script))
+                    for row in data if isinstance(data, list) else [data]:
+                        if isinstance(row, dict):
+                            self.jsonld.extend(row.get("@graph", [row]) if isinstance(row.get("@graph", [row]), list) else [row])
+                except ValueError:
+                    pass
+            self._skip -= 1
+            self._json = False
+        elif self._skip:
+            return
+        elif tag == "title":
+            self._title = False
+        elif tag == "a" and self._anchor:
+            href, label, locator, relation = self._anchor
+            link = _link(href, self.base, relation, label="".join(label), locator=locator)
+            if link:
+                self.links.append(link)
+            self._anchor = None
+        if not self._skip and tag in {"p", "div", "article", "section", "h1", "h2", "h3", "li", "tr"}:
+            self.chunks.append("\n")
+
+    def handle_data(self, data):
+        if self._excluded:
+            return
+        if self._skip:
+            if self._json:
+                self._script.append(data)
+        elif self._title:
+            self.title.append(data)
+        else:
+            self.chunks.append(data)
+            if self._anchor:
+                self._anchor[1].append(data)
+
+    def first(self, *names):
+        return next((_clean(value) for name in names for value in self.meta.get(name, []) if _clean(value)), "")
+
+    @property
+    def text(self):
+        return "\n".join(line for line in (_clean(line) for line in "".join(self.chunks).splitlines()) if line)
+
+
+def _author(value) -> str:
+    if isinstance(value, list):
+        return "; ".join(filter(None, (_author(item) for item in value)))
+    if isinstance(value, dict):
+        return _clean(value.get("name"))
+    return _clean(value)
+
+
+class _ReadmeHTML(HTMLParser):
+    """Retain rendered Markdown or article markup without surrounding menus."""
+
+    _void = frozenset({"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr"})
+
+    def __init__(self, *, mode="markdown"):
+        super().__init__(convert_charrefs=False)
+        self.mode = mode
+        self.stack = []
+        self.parts = []
+        self._excluded = []
+
+    def handle_starttag(self, tag, attrs):
+        values = dict(attrs)
+        if self._excluded:
+            if tag == self._excluded[-1]:
+                self._excluded.append(tag)
+            return
+        if _navigation(tag, values, in_content=bool(self.stack)):

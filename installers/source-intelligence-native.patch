+
+PLAN_SCHEMA = "last30days-intelligence-plan/1"
+MAX_PLAN_BYTES = 16_384
+MAX_PLAN_QUERIES = 6
+_COMMUNITY_SOURCES = frozenset({"reddit", "hackernews", "x", "xquik", "digg", "bluesky", "truthsocial",
+                              "youtube", "tiktok", "instagram", "threads", "pinterest", "telegram", "linkedin"})
+_COMMUNITY_HOSTS = frozenset({"reddit.com", "redd.it", "news.ycombinator.com", "x.com", "twitter.com",
+                            "youtube.com", "youtu.be", "tiktok.com", "instagram.com", "bsky.app",
+                            "threads.net", "threads.com", "pinterest.com", "t.me", "linkedin.com"})
+_NAVIGATION_PATHS = frozenset({"about", "contact", "careers", "login", "search", "topics", "tags",
+                             "categories", "archive", "archives", "explore", "settings", "marketplace",
+                             "resources", "open-source"})

+    private.write_text("LAST30DAYS_INTEL_REPORT_DIR=/unused/file/location\nLAST30DAYS_INTEL_CHANNELS=webhook\nLAST30DAYS_INTEL_WEBHOOK_URL=https://notify.test/hook\n")

+    reclaimed = knowledge.claim_watch(now=401, lease_seconds=300)
+    assert reclaimed and reclaimed["id"] == abandoned["id"]
+    # An expired owner's completion must not clear the new owner's lease.
+    knowledge.finish_watch(abandoned, "completed")
+    assert knowledge.claim_watch(now=402) is None
+    knowledge.finish_watch(reclaimed, "completed")

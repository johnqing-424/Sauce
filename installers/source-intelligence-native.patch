+def test_budget_rejects_cost_call_and_deadline_overruns():
+    clock = [0.0]
+    budget = Budget(Limits(max_calls=2, max_seconds=5), clock=lambda: clock[0])
+    assert budget.take() == 5
+    with pytest.raises(BudgetExceeded, match="cost"):
+        budget.take(cost_usd=0.01)
+    assert budget.calls == 1
+    budget.take()
+    with pytest.raises(BudgetExceeded, match="call"):
+        budget.take()
+    timed = Budget(Limits(max_seconds=5), clock=lambda: clock[0])

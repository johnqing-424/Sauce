+class SimulatedDiscovery:
+    def __init__(self, candidates=(), documents=None, *, failures=()):
+        self.candidates = list(candidates)
+        self.documents = documents or {}
+        self.last_failures = list(failures)
+        self.queries = []
+        self.fetched = []
+
+    def discover(self, domain, budget, since, limit=8):
+        budget.take()
+        self.queries.append(domain)
+        return self.candidates[:limit]
+
+    def fetch(self, url, budget):
+        budget.take()
+        self.fetched.append(url)
+        return self.documents[url]
+
+
+def settings_for(tmp_path, **limits):
+    settings = load_settings()
+    settings.update(db=str(tmp_path / "research.db"), report_dir=str(tmp_path / "reports"))
+    settings["limits"].update(limits)
+    return settings
+
+
+def simulated_engine(candidates=(), statuses=None):
+    def collect(domain, budget, **kwargs):
+        budget.take()
+        return {"candidates": list(candidates), "source_status": statuses or {},
+                "real_external": False, "test_fixture": True}
+    return collect
+
+
+def primary(url, *, links=()):
+    return Document(url=url, title="Simulated original material", text="A documented local evaluation resource.",
+                    resource_type="repository" if "github.com/" in url else "official_document",
+                    primary_basis="owned_repository" if "github.com/" in url else "publisher_declared_original",
+                    links=list(links))
+

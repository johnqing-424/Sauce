+    method_code = "https://github.com/simulated/method"
+    docs = {portfolio: primary(portfolio), repo: primary(repo, links=[
+        Link(f"https://noise.example.org/{i}", "references") for i in range(20)]),
+        solver: primary(solver, links=[Link(solver_code, "code", "Code", "article:1")]),
+        method: primary(method, links=[Link(method_code, "code", "Code", "article:1")]),
+        solver_code: primary(solver_code), method_code: primary(method_code)}
+    docs.update({f"https://noise.example.org/{i}": primary(f"https://noise.example.org/{i}") for i in range(20)})
+    resolver = SimulatedDiscovery([
+        {"url": repo, "title": "Artificial intelligence toolkit", "source": "github"},
+        {"url": "https://github.com/simulated/awesome-ai", "title": "Awesome AI links", "source": "github"},
+    ], docs)
+    seeds = [{"url": portfolio, "title": "Personal portfolio and resume", "source": "hackernews"},
+             {"url": solver, "title": "AI mathematics evaluation", "source": "hackernews", "engagement": {"points": 0}},
+             {"url": method, "title": "A new AI training method", "source": "hackernews", "engagement": {"points": 0}}]

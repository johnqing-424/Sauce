+"""Quality regressions inspired by the real local failure; documents are simulated.
+
+These assertions assess triage and citation behavior, not scientific truth or
+the success of live web searches.
+"""
+import copy
+
+import pytest
+
+from lib.intelligence.analysis import add_agent_analysis, build_report
+from lib.intelligence.models import Document, Limits, Link
+from lib.intelligence.knowledge import Knowledge
+from lib.intelligence.reports import render_markdown
+from lib.intelligence.runner import Runner
+
+
+def report_for(documents, edges=None, previous=None):
+    return build_report({'url': documents[0].url}, documents, edges or [], [], {}, previous=previous, domain='AI')
+
+
+def project(text='A local inference SDK with a documented API and benchmark examples.', **kwargs):
+    return Document(url='https://github.com/simulated/sdk', title='simulated/sdk', text=text,
+                    resource_type='repository', primary_basis='owned_repository', **kwargs)
+
+
+def test_personal_website_metadata_cannot_be_high_value_intelligence():
+    doc = Document(url='https://github.com/simulated/simulated.github.io', title='Personal portfolio',
+                   text='Personal portfolio of a data scientist and AI builder. Owner: simulated.',
+                   resource_type='repository', primary_basis='owned_repository',
+                   metadata={'resource_kind': 'website_repository', 'content_scope': 'repository_metadata'})
+    report = report_for([doc])
+    assert report['tier'] == 'hold'
+    assert report['score']['total'] < 60
+    assert report['score']['components']['technical_value'] == 0
+    assert report['score']['components']['novelty'] == 0
+
+
+def test_new_to_database_does_not_mean_verified_novelty():
+    report = report_for([project()])
+    assert report['score']['components']['novelty'] == 0
+    assert report['score']['signals']['scientific_novelty'] == 'unknown'
+
+
+def test_metadata_alone_does_not_prove_usable_code():
+    doc = project('Owner: simulated. Created: 2026-10-01. A revolutionary SDK.',
+                  metadata={'content_scope': 'repository_metadata'})
+    report = report_for([doc])
+    assert report['score']['components']['technical_value'] == 0
+    assert report['score']['components']['application_potential'] == 0
+    assert report['analysis']['status'] == 'agent_review_required'
+
+
+def test_metadata_only_stays_on_hold_even_when_confidence_is_overweighted():
+    doc = project('Repository owner and creation metadata only.', metadata={'content_scope': 'repository_metadata'})
+    weights = {key: 0 for key in ('novelty', 'originality', 'technical_value', 'application_potential', 'evidence_quality', 'engagement')}
+    weights['confidence'] = 1
+    report = build_report({'url': doc.url}, [doc], [], [], {}, weights=weights, threshold_a=0, threshold_b=0)
+    assert report['tier'] == 'hold'
+
+
+def test_unrelated_artifacts_cannot_raise_value_or_be_underlying_evidence():
+    root = project(version='v1')
+    other = Document(url='https://github.com/other/dependency', text='An unrelated dataset.',
+                     resource_type='dataset', primary_basis='owned_dataset')
+    baseline = report_for([root])
+    extended = report_for([root, other], [{'from_url': root.url, 'to_url': other.url, 'relation': 'dependency'}])
+    assert baseline['score']['components'] == extended['score']['components']
+    assert other.url not in extended['source_trace']['underlying_evidence']
+    assert any(row['url'] == other.url for row in extended['source_trace']['related_resources'])
+
+
+def test_legacy_inflated_scores_are_recomputed_without_fabricating_source_change():
+    doc = project()
+    current = report_for([doc])
+    legacy = copy.deepcopy(current)
+    legacy['score'].pop('model_version', None)
+    legacy['score']['components']['novelty'] = 100
+    legacy['score']['total'] = 75.65
+    refreshed = report_for([doc], previous=legacy)
+    assert refreshed['revision'] == current['revision']
+    assert refreshed['score']['components']['novelty'] == 0
+    assert refreshed['score']['model_version'] == 'evidence-value/2'
+
+
+def test_important_repository_quote_comes_from_readme_not_only_metadata_header():
+    doc = project('Repository metadata\n' * 40 + 'README:\nThe SDK executes inference locally with a documented API.')
+    report = report_for([doc])
+    quote = report['evidence'][0]
+    assert 'executes inference locally' in quote['quote']
+    start, end = map(int, quote['locator'].removeprefix('text:chars:').split('-'))
+    assert doc.text[start:end] == quote['quote']
+
+
+def assessment(doc):
+    reference = {'url': doc.url, 'quote': 'The SDK executes inference locally with a documented API.'}
+    texts = {'finding': 'Local inference SDK with a documented interface.',
+             'new': 'The document describes local inference; comparison with prior tools remains unknown.',
+             'why_it_matters': 'The interface makes integration experiments practical.',
+             'application_potential': 'Evaluate it for an application that needs local inference.',
+             'limitations': 'Latency and compatibility have not been independently tested.',
+             'next_steps': 'Test the documented API on the target machine and compare latency.'}
+    return {'assessment': {key: {'text': text, 'evidence': [reference]} for key, text in texts.items()}}
+
+
+def test_cited_agent_assessment_replaces_boilerplate_without_upgrading_facts():
+    doc = project('The SDK executes inference locally with a documented API.')
+    report = report_for([doc])
+    old_score = copy.deepcopy(report['score'])
+    add_agent_analysis(report, assessment(doc), [doc])
+    assert report['summary'] == assessment(doc)['assessment']['finding']['text']
+    assert report['analysis']['why_it_matters'] == assessment(doc)['assessment']['why_it_matters']['text']
+    assert report['analysis']['status'] == 'evidence_linked_agent_review'
+    assert all(item['status'] == 'ai_inference' for item in report['analysis']['agent_assessment'].values())
+    assert report['score'] == old_score
+    assert not any(item['status'] == 'independently_verified' for item in report['claims'])
+
+
+@pytest.mark.parametrize('invalid', ['invented_quote', 'missing_field', 'unsupported_score', 'unknown_field'])
+def test_agent_assessment_rejects_ungrounded_or_incomplete_value_judgments(invalid):
+    doc = project('The SDK executes inference locally with a documented API.')
+    payload = assessment(doc)
+    if invalid == 'invented_quote':
+        payload['assessment']['new']['evidence'] = [{'url': doc.url, 'quote': 'Ten times better than every existing model.'}]
+    elif invalid == 'missing_field':
+        payload['assessment'].pop('limitations')
+    elif invalid == 'unsupported_score':
+        payload['assessment']['score'] = 100
+    else:
+        payload['assessment']['execute_shell'] = {'text': 'Do not execute anything', 'evidence': []}
+    with pytest.raises(ValueError):
+        add_agent_analysis(report_for([doc]), payload, [doc])
+
+
+def test_markdown_preserves_agent_assessment_citations_and_next_experiment():
+    doc = project('Metadata preface. ' * 30 + 'The SDK executes inference locally with a documented API.')
+    report = report_for([doc])
+    add_agent_analysis(report, assessment(doc), [doc])
+    markdown = render_markdown(report)
+    assert assessment(doc)['assessment']['next_steps']['text'] in markdown
+    assert assessment(doc)['assessment']['new']['text'] in markdown
+    assert '> The SDK executes inference locally with a documented API.' in markdown
+    assert 'AI interpretation; not independent verification' in markdown
+
+
+def test_explicit_host_snapshot_supersedes_fresh_metadata_cache_only_for_supplied_urls(tmp_path):
+    knowledge = Knowledge(tmp_path / 'db')
+    cached = project('Owner: simulated.', metadata={'content_scope': 'repository_metadata'})
+    knowledge.save_document(cached)
+    observed = project('The SDK executes inference locally with a documented API.')
+
+    class ExplicitSnapshotResolver:
+        def __init__(self):
+            self.fetched = []
+
+        def has_observation(self, url):
+            return url == observed.url
+
+        def fetch(self, url, budget):
+            budget.take()
+            self.fetched.append(url)
+            return observed
+
+    resolver = ExplicitSnapshotResolver()
+    report = Runner(knowledge, resolver).trace(cached.url)
+    assert resolver.fetched == [observed.url]
+    assert report['resources'][0]['text'] == observed.text
+    assert report['exploration']['cache_hits'] == 0
+
+
+def test_supplied_deep_evidence_is_explored_before_unfetched_upstream_links(tmp_path):
+    deep = Document('https://github.com/simulated/sdk/blob/main/BENCHMARKS.md', text='Measured on one machine; no cross-device guarantee.')
+    root = project(links=[Link('https://github.com/upstream/library', 'code'), Link(deep.url, 'documentation')])
+
+    class Resolver:
+        def has_observation(self, url):
+            return url == deep.url
+
+        def fetch(self, url, budget):
+            budget.take()
+            return {root.url: root, deep.url: deep}[url]
+
+    report = Runner(Knowledge(tmp_path / 'db'), Resolver(), Limits(max_calls=2, max_depth=1)).trace(root.url)
+    assert deep.url in {item['url'] for item in report['resources']}
+
+
+def test_git_clone_alias_does_not_consume_another_trace_slot(tmp_path):
+    deep = Document('https://github.com/simulated/sdk/blob/main/RESULTS.md', text='Original evaluation protocol with documented limitations.')
+    root = project(links=[Link(root_url := 'https://github.com/simulated/sdk.git', 'code'), Link(deep.url, 'documentation')])
+
+    class Resolver:
+        def fetch(self, url, budget):
+            budget.take()
+            return {root.url: root, root_url: root, deep.url: deep}[url]
+
+    report = Runner(Knowledge(tmp_path / 'db'), Resolver(), Limits(max_calls=2, max_depth=1)).trace(root.url)
+    assert deep.url in {item['url'] for item in report['resources']}
+    assert len([item for item in report['resources'] if item['url'] == root.url]) == 1
+
+
+def test_unchanged_snapshot_retains_validated_review_without_new_material_revision():
+    doc = project('The SDK executes inference locally with a documented API.')
+    previous = report_for([doc])
+    add_agent_analysis(previous, assessment(doc), [doc])
+    current = report_for([doc], previous=previous)
+    assert current['revision'] == previous['revision']
+    assert current['analysis']['status'] == 'evidence_linked_agent_review'
+    assert current['summary'] == previous['summary']
+
+
+def test_default_a_threshold_is_reachable_without_inventing_innovation_points():
+    from lib.intelligence.configuration import load_settings
+    maximum = 60*.15 + 50*.15 + 100*.2 + 100*.15 + 85*.2 + 100*.15
+    assert load_settings()['threshold_a'] <= maximum
+
+
+def test_default_a_is_reachable_through_a_supported_single_artifact_update_path():
+    from datetime import datetime, timezone
+    from lib.intelligence.configuration import load_settings
+    published = datetime.now(timezone.utc).date().isoformat()
+    first = project('The initial SDK has a documented API.', published_at=published, version='v1')
+    previous = report_for([first])
+    current = project('The updated SDK adds a documented inference API and installation examples.', published_at=published, version='v2')
+    report = report_for([current], previous=previous)
+    assert report['score']['total'] >= load_settings()['threshold_a']
+    assert report['score']['signals']['scientific_novelty'] == 'unknown'
+    assert report['tier'] == 'A'
+
+
+def test_profile_readme_repository_is_a_background_entry_even_for_direct_trace():
+    doc = project('Personal coding notes and a list of projects.',
+                  metadata={'resource_kind': 'author_profile', 'content_scope': 'profile_readme'})
+    assert report_for([doc])['tier'] == 'hold'
+
+
+@pytest.mark.parametrize('title', ['Personal portfolio optimization toolkit', 'Personal portfolio risk analysis toolkit'])
+def test_financial_portfolio_project_is_not_a_personal_profile(title):
+    doc = project(title + '\nA documented SDK API for investment decisions.', version='v1',
+                  metadata={'resource_kind': 'repository', 'content_scope': 'repository_readme', 'discovery_role': 'project'})
+    report = report_for([doc])
+    assert report['score']['signals']['material_content_available']
+    assert report['score']['signals']['discovery_role'] == 'artifact_candidate'
+    assert report['tier'] == 'B'
+
+
+def test_repeated_historical_only_import_stays_on_hold():
+    doc = project(version='v1', metadata={'freshness_status': 'historical_not_revalidated'})
+    first = report_for([doc])
+    second = report_for([doc], previous=first)
+    third = report_for([doc], previous=second)
+    assert {first['tier'], second['tier'], third['tier']} == {'hold'}
+    assert first['revision'] == second['revision'] == third['revision']

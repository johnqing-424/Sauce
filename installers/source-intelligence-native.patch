+def _delivery_key(job: dict, index: int) -> str:
+    identity = [job[key] for key in ("event_id", "revision", "channel", "tier", "period_key")] + [index]
+    return hashlib.sha256(_json(identity).encode("utf-8")).hexdigest()
+

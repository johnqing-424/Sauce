+    profile.write_text(json.dumps(original))
+    result = repair_module().configure_proxy(profile, 'http://127.0.0.1:7897', probe=lambda url: True)
+    assert json.loads(profile.read_text()) == {**original, 'local_proxy_url': 'http://127.0.0.1:7897'}
+    assert json.loads(Path(result['backup']).read_text()) == original

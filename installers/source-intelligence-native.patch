@@ -0,0 +1,388 @@
+"""Offline regressions for host-directed research; all external bodies are simulated."""
+
+import json
+from pathlib import Path
+
+import pytest
+
+import intelligence
+from lib.intelligence.configuration import load_settings
+from lib.intelligence.discovery import validate_plan
+from lib.intelligence.models import Budget, Document, Limits
+from lib.intelligence.service import IntelligenceService
+from lib.intelligence.transport import PublicTransport, Response, SourceError
+
+
+def settings(tmp_path):
+    result = load_settings()
+    result.update(db=str(tmp_path / "research.db"), report_dir=str(tmp_path / "reports"))
+    return result
+
+
+def engine(domain, budget, **kwargs):
+    budget.take()
+    return {"candidates": [], "source_status": {"hackernews": {"state": "no-results"}},
+            "real_external": False, "test_fixture": True}
+
+
+class NoAnonymousSearch:
+    def discover(self, *args, **kwargs):
+        pytest.fail("native collection must hand search to the host")
+
+    def fetch(self, *args, **kwargs):
+        pytest.fail("collection/briefing must not fetch material")
+
+
+def plan():
+    return {"domain": "AI", "queries": [
+        {"query": "AI inference memory efficiency", "rationale": "Reduce deployment memory",
+         "providers": {"github": "quantization", "arxiv": "cat:cs.LG AND all:quantization", "web": "LLM KV cache memory research"}},
+        {"query": "agent reliability", "rationale": "Find reproducible failure evaluation"},
+    ]}
+
+
+def test_native_collection_preserves_upstream_and_hands_search_to_host(tmp_path):
+    service = IntelligenceService(settings(tmp_path), resolver=NoAnonymousSearch(), engine_fn=engine)
+    result = service.discover("AI", collect_only=True, plan=plan(), native_search=True)
+    assert result["upstream"]["source_status"]["hackernews"]["state"] == "no-results"
+    assert result["reports"] == [] and result["budget"]["operations"] == 1
+    handoff = result["research_handoff"]
+    assert handoff["required_action"] == "use_host_search"
+    assert handoff["semantic_review"] == "required"
+    assert handoff["queries"][0]["providers"]["github"].startswith("quantization created:>=")
+    assert handoff["queries"][0]["providers"]["arxiv"].startswith("cat:cs.LG AND all:quantization")
+    assert all(row["status"] == "host_search_pending" for row in result["collection_queries"])
+    assert result["status"] == "partial"
+    with service.knowledge.connection() as conn:
+        assert conn.execute("SELECT COUNT(*) FROM intel_events").fetchone()[0] == 0
+        assert conn.execute("SELECT COUNT(*) FROM intel_outbox").fetchone()[0] == 0
+
+
+def test_provider_queries_are_optional_bounded_data():
+    validated = validate_plan(plan(), "AI")
+    assert validated["queries"][0]["providers"]["github"] == "quantization"
+    assert "providers" not in validated["queries"][1]
+    invalid = plan()
+    invalid["queries"][0]["providers"]["shell"] = "execute this"
+    with pytest.raises(ValueError):
+        validate_plan(invalid, "AI")
+
+
+def test_sparse_headless_results_request_search_expansion(tmp_path):
+    class Empty(NoAnonymousSearch):
+        last_failures = []
+
+        def discover(self, *args, **kwargs):
+            return []
+
+    service = IntelligenceService(settings(tmp_path), resolver=Empty(), engine_fn=engine)
+    result = service.discover("AI", collect_only=True)
+    assert result["research_handoff"]["required_action"] == "expand_search"
+    assert "small_candidate_pool" in result["research_handoff"]["reasons"]
+
+
+@pytest.mark.parametrize("args", [["discover", "AI", "--native-search"],
+                                 ["discover", "AI", "--collect-only", "--host-only"]])
+def test_native_flags_require_their_actual_host_workflow(tmp_path, args):
+    with pytest.raises(ValueError):
+        intelligence.main(["--db", str(tmp_path / "test.db")] + args, resolver=NoAnonymousSearch(), engine_fn=engine)
+
+
+def test_github_rate_limit_is_distinguished_from_an_unknown_403():
+    url = "https://api.github.com/repos/simulated/tool"
+    client = PublicTransport(sender=lambda *args: Response(url, 403, {
+        "X-RateLimit-Remaining": "0", "X-RateLimit-Reset": "1791900000",
+        "X-RateLimit-Resource": "core", "Retry-After": "60",
+        "Set-Cookie": "do-not-log", "Authorization": "Bearer do-not-log",
+    }, b"untrusted secret body"))
+    with pytest.raises(SourceError) as failure:
+        client.get(url, Budget(Limits()))
+    details = failure.value.to_dict()
+    assert details["kind"] == "rate_limit"
+    assert details["diagnostics"]["rate_limit_remaining"] == 0
+    assert details["diagnostics"]["retry_after_seconds"] == 60
+    assert details["diagnostics"]["request_authentication"] == "anonymous"
+    assert "do-not-log" not in json.dumps(details)
+
+    client = PublicTransport(sender=lambda *args: Response(url, 403, {}, b"blocked"))
+    with pytest.raises(SourceError) as unknown:
+        client.get(url, Budget(Limits()))
+    assert unknown.value.to_dict()["diagnostics"]["cause"] == "access_denied_cause_unknown"
+
+
+def test_batch_analysis_and_research_brief_use_cached_evidence(tmp_path):
+    url = "https://github.com/simulated/tool"
+    quote = "The evaluation records the limits of the documented tool."
+
+    class Material(NoAnonymousSearch):
+        def fetch(self, target, budget):
+            assert target == url
+            budget.take()
+            return Document(url, title="Simulated tool", text=quote, resource_type="repository",
+                            primary_basis="owned_repository")

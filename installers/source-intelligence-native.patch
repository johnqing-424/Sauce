+        raise DeliveryError("transaction_pending")
+    init_schema(conn)
+    current = lambda: float(now) if now is not None else time.time()
+    runtime = {channel: ChannelConfig(config) for channel, config in configs.items()}
+    result = {"sent": 0, "chunks_sent": 0, "failed": 0, "retried": 0, "skipped": 0, "previews": []}
+    # The exact query below also appears in root-0-34.output.txt.
+    outstanding = _rows(conn.execute("SELECT * FROM intel_outbox WHERE status IN ('pending','leased') ORDER BY id"))
+    attempted = set()
+    if dry_run:
+        moment = current()
+        for job in outstanding:
+            if job["next_attempt_at"] > moment or (job["status"] == "leased" and (job["lease_until"] or 0) > moment):
+                result["skipped"] += 1
+                continue
+            report, chunks = json.loads(job["report_json"]), json.loads(job["chunks_json"])
+            for index in range(job["next_chunk"], job["total_chunks"]):
+                result["previews"].append({"outbox_id": job["id"], "channel": job["channel"], "tier": job["tier"],
+                                           "period_key": job["period_key"], "chunk_index": index,
+                                           "payload": _payload(job, report, chunks[index], index,
+                                                               runtime.get(job["channel"], {}), preview=True)})
+        return result
+    send = sender if sender is not None else _send
+    while True:
+        job = _claim(conn, list(runtime), current(), min_interval_seconds, max_attempts)
+        if job is None:
+            break
+        attempted.add(job["id"])
+        report, chunks = json.loads(job["report_json"]), json.loads(job["chunks_json"])
+        start = job["next_chunk"]
+        for index in range(start, job["total_chunks"]):
+            if index != start and not _reserve_next(conn, job, current(), min_interval_seconds):
+                break
+            try:
+                # This call is readable in root-0-14.output.txt.
+                send(job["channel"], runtime[job["channel"]], _payload(job, report, chunks[index], index, runtime[job["channel"]]))
+            except Exception as error:
+                # These four lines are recovered from delivery-0-15's full patch.
+                code = error.code if isinstance(error, DeliveryError) else "sender_error"
+                if not isinstance(code, str) or code not in _SAFE_ERRORS:
+                    code = "sender_error"
+                result["failed"] += 1
+                if _fail(conn, job, index, current(), code, min_interval_seconds, max_attempts):
+                    result["retried"] += 1
+                break
+            if not _ack(conn, job, index, current()):
+                break
+            result["chunks_sent"] += 1
+            if index + 1 == job["total_chunks"]:
+                result["sent"] += 1
+    result["skipped"] = sum(job["id"] not in attempted for job in outstanding)
+    return result

+    # Digests summarize completed periods, not the current partial day/week.
+    with Knowledge(tmp_path / "research.db").connection() as conn:
+        conn.execute("UPDATE intel_events SET updated_at=datetime('now','-30 days')")
+        conn.execute("UPDATE intel_revisions SET created_at=datetime('now','-30 days')")

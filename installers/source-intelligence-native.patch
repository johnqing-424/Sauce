+def flush(conn: sqlite3.Connection, configs: dict[str, dict], dry_run: bool = True,
+          sender: Callable[[str, dict, dict], None] | None = None, now: float | None = None,
+          min_interval_seconds: float = 1, max_attempts: int = 3) -> dict:
+    """Preview or send due jobs, returning counters and credential-free previews.
+
+    sent counts completed jobs; chunks_sent counts acknowledgments; failed counts
+    failed send attempts; retried counts attempts scheduled for a later retry;
+    skipped counts outstanding jobs not attempted (config, due time, rate, lease).
+    attempts in SQLite count the current chunk, resetting after acknowledgment.
+    A custom sender must raise on rejection; returning None means acknowledged.
+    """

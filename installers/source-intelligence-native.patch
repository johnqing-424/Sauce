+def test_simulated_proxy_connect_is_pinned_and_tls_keeps_origin_hostname():
+    import urllib.request
+    transport, _, _ = modules()
+    opener = transport._pinned_opener("https://example.com/", ["8.8.8.8"])
+    handler = next(item for item in opener.handlers if isinstance(item, urllib.request.HTTPSHandler))
+    assert handler._context.check_hostname is True
+    assert handler._context.verify_mode == transport.ssl.CERT_REQUIRED
+    captured = {}
+    def capture(connection_type, request, context):
+        captured["type"] = connection_type
+    handler.do_open = capture
+    handler.https_open(urllib.request.Request("https://example.com/"))
+    tls = SimpleNamespace(check_hostname=True, wrap_socket=lambda sock, server_hostname: captured.setdefault("sni", server_hostname))
+    connection = captured["type"]("configured-proxy.example:8080", context=tls)
+    connection.set_tunnel("example.com", 443)
+    connection._create_connection = lambda address, timeout, source: captured.setdefault("connection", address)
+    connection._tunnel = lambda: captured.setdefault("tunnel", connection._tunnel_host)
+    connection.connect()
+    assert captured["connection"] == ("configured-proxy.example", 8080)
+    assert captured["tunnel"] == "8.8.8.8"
+    assert captured["sni"] == "example.com"
+

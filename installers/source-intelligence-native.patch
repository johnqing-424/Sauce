+def _payload(job: dict, report: dict, text: str, index: int, config: dict, preview: bool = False) -> dict:
+    channel = job["channel"]
+    if channel == "telegram":
+        return {"chat_id": "<redacted>" if preview else config.get("chat_id", ""), "text": text,
+                "link_preview_options": {"is_disabled": True}}
+    if channel == "feishu":
+        return {"msg_type": "post", "content": {"post": {"en_us": {
+            "title": f"last30days {job['tier']} {index + 1}/{job['total_chunks']}",
+            "content": [[{"tag": "text", "text": text}]]}}}}
+    if channel == "slack":
+        return {"text": text, "blocks": [{"type": "section", "text": {"type": "plain_text", "text": text}}],
+                "unfurl_links": False, "unfurl_media": False}
+    if channel == "wecom":
+        return {"msgtype": "text", "text": {"content": text}}
+    if channel == "smtp":
+        title = str(report.get("title") or "Intelligence report").replace("\r", " ").replace("\n", " ")[:180]
+        return {"subject": f"[last30days {job['tier']} {index + 1}/{job['total_chunks']}] {title}", "body": text}
+    return {"source": "last30days", "kind": "source_intelligence", "event_id": job["event_id"],
+            "revision": job["revision"], "tier": job["tier"], "period_key": job["period_key"],
+            "idempotency_key": _delivery_key(job, index),
+            "chunk": {"index": index, "count": job["total_chunks"]}, "text": text, "report": report}
+

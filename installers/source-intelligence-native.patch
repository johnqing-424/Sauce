+def test_concurrent_workers_claim_one_job_atomically(module, report, tmp_path):
+    path = tmp_path / "simulated-outbox.db"
+    connection = sqlite3.connect(path)
+    module.init_schema(connection)
+    module.enqueue(connection, report, "webhook")
+    connection.close()
+    entered = threading.Event()
+    release = threading.Event()
+    calls = []
+
+    def worker(block):
+        db = sqlite3.connect(path, timeout=3)
+        def sender(*args):
+            calls.append(args)
+            entered.set()
+            if block:
+                assert release.wait(3)
+        try:
+            return module.flush(db, {"webhook": {}}, dry_run=False, sender=sender,
+                                now=100, min_interval_seconds=0)
+        finally:
+            db.close()
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        first = pool.submit(worker, True)
+        assert entered.wait(3)
+        second = pool.submit(worker, False).result(timeout=3)
+        release.set()
+        first_result = first.result(timeout=3)
+    assert len(calls) == 1
+    assert second["sent"] == 0 and first_result["sent"] == 1
+

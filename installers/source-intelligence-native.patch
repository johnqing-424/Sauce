+def _log(conn: sqlite3.Connection, job: dict, index: int, outcome: str, now: float, error: str | None = None):
+    conn.execute("""INSERT INTO intel_delivery_log
+        (outbox_id,channel,chunk_index,attempt,outcome,attempted_at,error_code,idempotency_key)
+        VALUES (?,?,?,?,?,?,?,?)""", (job["id"], job["channel"], index, job["attempts"], outcome, now, error,
+                                      _delivery_key(job, index)))

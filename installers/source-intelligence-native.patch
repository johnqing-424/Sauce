+"""Simulated Windows Fake-IP/proxy scenarios; no real proxy or search is used."""
+import io
+import json
+import socket
+import ssl
+import urllib.request
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from lib.intelligence import configuration, transport
+from lib.intelligence.models import Budget, Limits
+
+
+def unmanaged(monkeypatch, tmp_path):
+    monkeypatch.setattr(transport, '_MANAGED_POLICY_PATH', tmp_path / 'absent-policy.json')
+    monkeypatch.setattr(transport, '_managed_proxy_route', lambda url: None)
+
+
+def test_simulated_private_profile_config_is_used_without_project_config(monkeypatch, tmp_path):
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path / 'home')
+    monkeypatch.delenv('LAST30DAYS_INTEL_CONFIG', raising=False)
+    private = tmp_path / 'home/.config/last30days/intelligence.json'
+    private.parent.mkdir(parents=True)
+    private.write_text(json.dumps({'local_proxy_url': 'http://127.0.0.1:7897'}))
+    project = tmp_path / 'project'
+    project.mkdir()
+    (project / 'intelligence.json').write_text('{"threshold_a":0}')
+    monkeypatch.chdir(project)
+    cfg = configuration.load_settings()
+    assert cfg['local_proxy_url'] == 'http://127.0.0.1:7897'
+    assert cfg['threshold_a'] == 65
+    explicit = tmp_path / 'explicit.json'
+    explicit.write_text('{"local_proxy_url":null}')
+    assert configuration.load_settings(str(explicit))['local_proxy_url'] is None
+
+
+@pytest.mark.parametrize('url', [
+    'http://proxy.example:7897', 'http://169.254.169.254:80',
+    'http://user:secret@127.0.0.1:7897', 'socks5://127.0.0.1:7897',
+    'http://127.0.0.1:7897/control', 'http://127.0.0.1:7897/?token=secret',
+    'http://127.0.0.1', 'http://127.0.0.1:0',
+])
+def test_simulated_proxy_config_requires_explicit_loopback_http(url, tmp_path):
+    path = tmp_path / 'config.json'
+    path.write_text(json.dumps({'local_proxy_url': url}))
+    with pytest.raises((ValueError, transport.SourceError)):
+        configuration.load_settings(str(path))
+
+
+def test_simulated_local_proxy_retrieval_delegates_fake_dns_and_records_limits(monkeypatch, tmp_path):
+    unmanaged(monkeypatch, tmp_path)
+    monkeypatch.setattr(transport, 'validate_public_url', lambda url: pytest.fail('local fake DNS must not be called'))
+    class Response(io.BytesIO):
+        code = 200
+        headers = {'content-type': 'text/plain'}
+    routes = []
+    monkeypatch.setattr(transport, '_managed_opener', lambda url, proxy, **kw: routes.append((url, proxy)) or SimpleNamespace(open=lambda req, timeout: Response(b'Simulated public evidence')))
+    response = transport._request_once('https://github.com/simulated/repo', 1, 100, local_proxy_url='http://127.0.0.1:7897')
+    assert routes == [('https://github.com/simulated/repo', 'http://127.0.0.1:7897')]
+    assert response.retrieval['dns_validation'] == 'delegated_to_trusted_local_proxy'
+    assert response.retrieval['local_address_verified'] is False
+
+
+def test_simulated_unknown_host_still_rejects_nonpublic_dns_with_local_proxy(monkeypatch, tmp_path):
+    unmanaged(monkeypatch, tmp_path)
+    monkeypatch.setattr(transport.socket, 'getaddrinfo', lambda *a, **kw: [(socket.AF_INET, socket.SOCK_STREAM, 6, '', ('198.18.0.70', 443))])
+    with pytest.raises(transport.SourceError, match='nonpublic'):
+        transport._request_once('https://unknown.example/research', 1, 100, local_proxy_url='http://127.0.0.1:7897')
+
+
+def test_simulated_local_proxy_cannot_allow_private_redirects():
+    calls = []
+    def sender(url, timeout, maximum):
+        calls.append(url)
+        return transport.Response(url, 302, {'location': 'https://127.0.0.1/private'}, b'')
+    t = transport.PublicTransport(sender=sender, local_proxy_url='http://127.0.0.1:7897')
+    with pytest.raises(transport.SourceError, match='nonpublic'):
+        t.get('https://github.com/simulated/repo', Budget(Limits()))
+    assert calls == ['https://github.com/simulated/repo']
+
+
+def test_simulated_local_proxy_cannot_override_managed_policy(monkeypatch, tmp_path):
+    unmanaged(monkeypatch, tmp_path)
+    path = tmp_path / 'policy.json'
+    path.write_text('{"version":1}')
+    monkeypatch.setattr(transport, '_MANAGED_POLICY_PATH', path)
+    with pytest.raises(transport.SourceError, match='network_policy'):
+        transport._request_once('https://github.com/simulated/repo', 1, 100, local_proxy_url='http://127.0.0.1:7897')
+
+
+def test_simulated_proxy_option_reaches_bounded_worker_without_leaking_to_evidence(monkeypatch):
+    captured = []
+    def run(command, **kwargs):
+        captured.append(json.loads(kwargs['input_text']))
+        return SimpleNamespace(returncode=0, stdout=json.dumps({'url':'https://github.com/simulated/repo', 'status':200,'headers':{'content-type':'text/plain'},'body':'','retrieval':{}}))
+    monkeypatch.setattr(transport.subproc, 'run_with_timeout', run)
+    t = transport.PublicTransport(local_proxy_url='http://127.0.0.1:7897')
+    result = t.get('https://github.com/simulated/repo', Budget(Limits()))
+    assert captured[0]['local_proxy_url'] == 'http://127.0.0.1:7897'
+    assert '127.0.0.1' not in json.dumps(result.retrieval)
+
+
+def test_simulated_loopback_connect_retains_origin_certificate_validation():
+    opener = transport._managed_opener('https://github.com/simulated/repo', 'http://127.0.0.1:7897')
+    handler = next(h for h in opener.handlers if isinstance(h, urllib.request.HTTPSHandler))
+    assert handler._context.check_hostname is True
+    assert handler._context.verify_mode == ssl.CERT_REQUIRED
+    captured = {}
+    handler.do_open = lambda connection, request, context: captured.setdefault('type', connection)
+    handler.https_open(urllib.request.Request('https://github.com/simulated/repo'))
+    connection = captured['type']('127.0.0.1:7897', context=handler._context)
+    connection.set_tunnel('github.com', 443)
+    def fake_socket(address, timeout, source):
+        captured['connection'] = address
+        return SimpleNamespace(setsockopt=lambda *args: None)
+    connection._create_connection = fake_socket
+    connection._tunnel = lambda: captured.setdefault('tunnel', connection._tunnel_host)
+    connection._context = SimpleNamespace(wrap_socket=lambda sock, server_hostname: captured.setdefault('sni', server_hostname))
+    connection.connect()
+    assert captured['connection'] == ('127.0.0.1', 7897)
+    assert captured['tunnel'] == 'github.com'
+    assert captured['sni'] == 'github.com'
+    connection = captured['type']('127.0.0.1:7897', context=handler._context)
+    connection.set_tunnel('private.example', 443)
+    with pytest.raises(transport.SourceError, match='configured proxy tunnel'):
+        connection.connect()
+
+
+def test_private_proxy_profile_is_applied_to_service_transport(tmp_path):
+    from lib.intelligence.service import IntelligenceService
+    profile = tmp_path / 'private.json'
+    profile.write_text(json.dumps({'local_proxy_url': 'http://127.0.0.1:7897',
+                                  'db': str(tmp_path / 'research.db'), 'report_dir': str(tmp_path / 'reports')}))
+    service = IntelligenceService(configuration.load_settings(str(profile)))
+    assert service.resolver.transport.local_proxy_url == 'http://127.0.0.1:7897'
+
+
+def test_simulated_explicit_local_proxy_reaches_selected_tunnel_despite_no_proxy(monkeypatch, tmp_path):
+    unmanaged(monkeypatch, tmp_path)
+    monkeypatch.setattr(urllib.request, 'proxy_bypass', lambda host: True)
+    captured = []
+    monkeypatch.setattr(transport.http.client.HTTPSConnection, 'connect',
+                        lambda self: captured.append((self.host, self.port, self._tunnel_host)))
+    class SimulatedResponse(io.BytesIO):
+        code, msg = 200, 'OK'
+        headers = {'content-type': 'text/plain'}
+        def info(self):
+            return self.headers
+    def open_connection(handler, connection_type, request, context):
+        connection = connection_type(request.host, context=context)
+        if request._tunnel_host:
+            connection.set_tunnel(request._tunnel_host, 443)
+        connection.connect()
+        return SimulatedResponse(b'Simulated evidence through the explicit proxy')
+    monkeypatch.setattr(urllib.request.HTTPSHandler, 'do_open', open_connection)
+    result = transport._request_once('https://github.com/simulated/repo', 1, 100, local_proxy_url='http://127.0.0.1:7897')
+    assert result.retrieval['dns_validation'] == 'delegated_to_trusted_local_proxy'
+    assert captured == [('127.0.0.1', 7897, 'github.com')]

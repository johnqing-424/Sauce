+@pytest.mark.parametrize("path, expected", [
+    ("simulated/robot", "code"), ("simulated/robot/", "code"), ("simulated/robot.git", "code"),
+    ("simulated/robot/blob/main/README.md", "documentation"),
+    ("simulated/robot/blob/main/docs/paper.pdf", "documentation"),
+    ("simulated/robot/tree/main/docs", "documentation"),
+    ("simulated/robot/issues/123", "references"), ("simulated/robot/discussions/456", "references"),
+    ("simulated/robot/pull/123", "references"), ("simulated/robot/releases", "release"),
+    ("simulated/robot/releases/tag/v0.1", "release"), ("simulated", "author"),
+    ("topics/robotics", None), ("orgs/simulated/people", None), ("login", None),

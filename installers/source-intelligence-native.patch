+from lib.intelligence.transport import Response, SourceError
+
+
+class SimulatedTransport:
+    def __init__(self, routes):
+        self.routes = routes
+        self.requested = []
+
+    def get(self, url, budget):
+        budget.take()
+        self.requested.append(url)
+        assert url in self.routes, f"unexpected request in simulated fixture: {url}"
+        result = self.routes[url]
+        if isinstance(result, Exception):
+            raise result
+        return result
+
+
+def html_response(url, html):
+    return Response(url, 200, {"content-type": "text/html"}, html.encode())
+
+
+def json_response(url, data):
+    return Response(url, 200, {"content-type": "application/json"}, json.dumps(data).encode())
+
+
+def simulated_repo_fixture(name="robot", description="Simulated research project", readme=None):
+    url = "https://github.com/simulated-owner/" + name
+    api = "https://api.github.com/repos/simulated-owner/" + name
+    repo = {"full_name": "simulated-owner/" + name, "html_url": url, "description": description,
+            "owner": {"login": "simulated-owner", "html_url": "https://github.com/simulated-owner"},
+            "fork": False, "mirror_url": None}
+    routes = {api: json_response(api, repo), api + "/releases/latest": SourceError("http", "HTTP 404", status=404)}
+    routes[api + "/readme"] = SourceError("http", "HTTP 404", status=404) if readme is None else json_response(api + "/readme", {
+        "encoding": "base64", "path": "README.md", "content": base64.b64encode(readme.encode()).decode(),
+    })
+    return url, SimulatedTransport(routes)
+
+
+@pytest.mark.parametrize("path", [
+    "resources/articles?topic=ai", "resources/events", "resources/whitepapers", "open-source/sponsors",

+def _claim(conn: sqlite3.Connection, channels: list[str], now: float, interval: float, max_attempts: int) -> dict | None:
+    with _atomic(conn):
+        conn.execute("""UPDATE intel_outbox SET status='pending',lease_token=NULL,lease_until=NULL,updated_at=?
+            WHERE status='leased' AND lease_until<=?""", (now, now))
+        conn.execute("""UPDATE intel_outbox SET status='failed',last_error='lease_expired',updated_at=?
+            WHERE status='pending' AND attempts>=?""", (now, max_attempts))
+        if not channels:
+            return None
+        placeholders = ",".join("?" for _ in channels)
+        jobs = _rows(conn.execute(f"""SELECT o.* FROM intel_outbox o
+            WHERE o.status='pending' AND o.next_attempt_at<=? AND o.channel IN ({placeholders})
+            AND NOT EXISTS (SELECT 1 FROM intel_delivery_rate_limits r
+                            WHERE r.channel=o.channel AND r.next_send_at>?)
+            ORDER BY o.next_attempt_at,o.id LIMIT 1""", (now, *channels, now)))
+        if not jobs:
+            return None
+        job = jobs[0]
+        token = uuid.uuid4().hex
+        conn.execute("""UPDATE intel_outbox SET status='leased',lease_token=?,lease_until=?,
+            attempts=attempts+1,updated_at=? WHERE id=?""", (token, now + LEASE_SECONDS, now, job["id"]))
+        _reserve_rate(conn, job["channel"], now, interval)
+        job.update(status="leased", lease_token=token, lease_until=now + LEASE_SECONDS, attempts=job["attempts"] + 1)
+        return job
+
+
+def _ack(conn: sqlite3.Connection, job: dict, index: int, now: float) -> bool:
+    final = index + 1 == job["total_chunks"]
+    with _atomic(conn):
+        cursor = conn.execute("""UPDATE intel_outbox SET next_chunk=?,attempts=0,last_error=NULL,
+            status=?,sent_at=?,updated_at=?,lease_token=?,lease_until=? WHERE id=? AND lease_token=?""",
+            (index + 1, "sent" if final else "leased", now if final else None, now,
+             None if final else job["lease_token"], None if final else now + LEASE_SECONDS,
+             job["id"], job["lease_token"]))
+        if cursor.rowcount != 1:
+            return False
+        _log(conn, job, index, "sent", now)
+    job.update(next_chunk=index + 1, attempts=0)
+    return True
+
+
+def _reserve_next(conn: sqlite3.Connection, job: dict, now: float, interval: float) -> bool:
+    with _atomic(conn):
+        if not conn.execute("SELECT 1 FROM intel_outbox WHERE id=? AND lease_token=?",
+                            (job["id"], job["lease_token"])).fetchone():
+            return False
+        slot = conn.execute("SELECT next_send_at FROM intel_delivery_rate_limits WHERE channel=?", (job["channel"],)).fetchone()
+        if slot and slot[0] > now:
+            conn.execute("""UPDATE intel_outbox SET status='pending',lease_token=NULL,lease_until=NULL,
+                next_attempt_at=?,updated_at=? WHERE id=? AND lease_token=?""", (slot[0], now, job["id"], job["lease_token"]))
+            return False
+        conn.execute("UPDATE intel_outbox SET attempts=1,lease_until=?,updated_at=? WHERE id=? AND lease_token=?",
+                     (now + LEASE_SECONDS, now, job["id"], job["lease_token"]))
+        _reserve_rate(conn, job["channel"], now, interval)
+        job["attempts"] = 1
+        return True
+
+
+def _fail(conn: sqlite3.Connection, job: dict, index: int, now: float, error: str, interval: float, max_attempts: int) -> bool:
+    retry = job["attempts"] < max_attempts
+    due = now + min(3600.0, max(1.0, interval) * 2 ** (job["attempts"] - 1)) if retry else now
+    with _atomic(conn):
+        cursor = conn.execute("""UPDATE intel_outbox SET status=?,next_attempt_at=?,last_error=?,
+            updated_at=?,lease_token=NULL,lease_until=NULL WHERE id=? AND lease_token=?""",
+            ("pending" if retry else "failed", due, error, now, job["id"], job["lease_token"]))
+        if cursor.rowcount != 1:
+            return False
+        _log(conn, job, index, "retry" if retry else "failed", now, error)
+    return retry
+

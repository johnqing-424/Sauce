+                  "ranking_basis": "Agent-selected order; proxy scores are not scientific or practical value ranking",
+                  "delivery": {"sent": 0, "skipped": "local_research_brief"}}
+        return save_research_brief(result, self.settings["report_dir"])
+
+    def briefing(self, frequency: str, *, send: bool = False, now: datetime | None = None) -> dict:

@@ -0,0 +1,285 @@
+"""Offline service/outbox regressions for reviewed intelligence delivery.
+
+Fixtures are simulated source snapshots. Injected senders never call a provider.
+"""
+
+import copy
+import json
+from datetime import datetime, timezone
+
+import pytest
+
+from lib.intelligence import delivery
+from lib.intelligence.configuration import load_settings
+from lib.intelligence.models import Document
+from lib.intelligence.service import IntelligenceService
+
+
+URL = "https://github.com/simulated/review-sdk"
+QUOTE = "Simulated inference SDK provides a documented API and a fixed-device benchmark."
+SOURCE_TEXT = QUOTE + " No independent replication was performed."
+FIELDS = {
+    "finding": "模拟 SDK 提供 API 接口与固定设备的基准说明。",
+    "new": "仅确认观察到的材料；尚未比较先前工作，科学新颖性未知。",
+    "why_it_matters": "接口可作为集成检查线索，性能结论仍限于作者描述。",
+    "application_potential": "可用于离线推理接口原型，正式用途需在目标硬件验证。",
+    "limitations": "未观察到独立复现，不能把固定设备结果泛化为普遍收益。",
+    "next_steps": "先核对设备、输入与评价协议，再比较基线和输出正确性。",
+}
+
+
+class OfflineResolver:
+    def __init__(self):
+        self.document = Document(
+            url=URL, title="Simulated review SDK", text=SOURCE_TEXT,
+            resource_type="repository", primary_basis="simulated_owned_repository",
+            author="Simulated author", version="v1",
+            metadata={"content_scope": "repository_readme"},
+        )
+        self.failure = None
+
+    def fetch(self, url, budget):
+        budget.take()
+        if self.failure is not None:
+            raise self.failure
+        assert url == URL
+        return Document.from_dict(self.document.to_dict())
+
+
+@pytest.fixture
+def make_service(tmp_path, monkeypatch):
+    for key in ("LAST30DAYS_INTEL_CONFIG", "LAST30DAYS_INTEL_DB", "LAST30DAYS_INTEL_REPORT_DIR"):
+        monkeypatch.delenv(key, raising=False)
+    monkeypatch.setenv("LAST30DAYS_INTEL_WEBHOOK_URL", "https://example.org/simulated-secret-hook")
+    monkeypatch.setenv("LAST30DAYS_INTEL_TELEGRAM_BOT_TOKEN", "dummy-bot-token")
+    monkeypatch.setenv("LAST30DAYS_INTEL_TELEGRAM_CHAT_ID", "dummy-chat")
+
+    def create(*, channel="webhook", threshold_a=1, threshold_b=0):
+        monkeypatch.setenv("LAST30DAYS_INTEL_CHANNELS", channel)
+        settings = load_settings()
+        settings.update(db=str(tmp_path / "review.sqlite"), report_dir=str(tmp_path / "reports"),
+                        threshold_a=threshold_a, threshold_b=threshold_b)
+        return IntelligenceService(settings, resolver=OfflineResolver())
+    return create
+
+
+def assessment(**changes):
+    texts = dict(FIELDS, **changes)
+    return {"assessment": {
+        key: {"text": text, "evidence": [{"url": URL, "quote": QUOTE}]}
+        for key, text in texts.items()
+    }}
+
+
+def outbox(service):
+    with service.knowledge.connection() as conn:
+        return [dict(row) for row in conn.execute("SELECT * FROM intel_outbox ORDER BY id")]
+
+
+def previews(service):
+    with service.knowledge.connection() as conn:
+        return delivery.flush(conn, {}, now=100)["previews"]
+
+
+def flush(service, sender, *, now=100, interval=0):
+    with service.knowledge.connection() as conn:
+        return delivery.flush(conn, service.configs, dry_run=False, sender=sender,
+                              now=now, min_interval_seconds=interval)
+
+
+def test_new_a_candidate_is_not_queued_before_completed_agent_review(make_service):
+    service = make_service()
+    report = service.trace(URL)
+    assert report["tier"] == "A"  # An artifact proxy can qualify before semantic review.
+    assert report["analysis"]["status"] == "agent_review_required"
+    assert outbox(service) == []
+
+
+def test_legacy_cited_insights_are_not_a_completed_six_field_review(make_service):
+    service = make_service()
+    report = service.trace(URL, analysis={"insights": [{
+        "text": "该接口或许可帮助原型开发，这是待验证的推理。",
+        "evidence": [{"url": URL, "quote": QUOTE}],
+    }]})
+    assert report["analysis"]["agent_insights"]
+    assert report["analysis"]["status"] == "agent_review_required"
+    assert outbox(service) == []
+
+
+@pytest.mark.parametrize("missing", ["next_steps", "citations", "assessment"])
+def test_a_gate_rejects_incomplete_review_despite_reviewed_status(make_service, missing):
+    service = make_service()
+    report = service.runner.trace(URL, agent_analysis=assessment())
+    if missing == "assessment":
+        del report["analysis"]["agent_assessment"]
+    elif missing == "citations":
+        report["analysis"]["agent_assessment"]["finding"]["evidence"] = []
+    else:
+        del report["analysis"]["agent_assessment"][missing]
+    assert report["analysis"]["status"] == "evidence_linked_agent_review"
+    assert service._queue(report, "A") == 0
+    assert outbox(service) == []
+
+
+def test_completed_review_and_reviewed_rechecks_queue_one_material_revision(make_service):
+    service = make_service()
+    initial = service.trace(URL)
+    reviewed = service.trace(URL, analysis=assessment())
+    rechecked = service.trace(URL, analysis=assessment())
+    assert (initial["id"], initial["revision"]) == (reviewed["id"], reviewed["revision"])
+    assert (rechecked["id"], rechecked["revision"]) == (reviewed["id"], reviewed["revision"])
+    jobs = outbox(service)
+    assert len(jobs) == 1
+    stored = json.loads(jobs[0]["report_json"])
+    assert stored["analysis"]["status"] == "evidence_linked_agent_review"
+    assert set(stored["analysis"]["agent_assessment"]) == set(FIELDS)
+
+
+@pytest.mark.parametrize("channel", ["webhook", "telegram"])
+def test_never_attempted_legacy_placeholder_updates_without_new_event(make_service, channel):
+    service = make_service(channel=channel)
+    placeholder = service.runner.trace(URL)
+    with service.knowledge.connection() as conn:
+        assert delivery.enqueue(conn, placeholder, channel)  # A legacy, unreviewed job.
+    before = outbox(service)[0]
+    old_key = previews(service)[0]["payload"].get("idempotency_key")
+    reviewed = service.trace(URL, analysis=assessment())
+    after = outbox(service)[0]
+    assert len(outbox(service)) == 1
+    assert after["id"] == before["id"] and after["created_at"] == before["created_at"]
+    assert (after["event_id"], after["revision"]) == (reviewed["id"], reviewed["revision"])
+    assert json.loads(after["report_json"])["summary"] == FIELDS["finding"]
+    assert json.loads(after["report_json"])["analysis"]["agent_assessment"]
+    preview = previews(service)[0]["payload"]
+    assert preview.get("idempotency_key") == old_key
+    text = "".join(json.loads(after["chunks_json"]))
+    assert "Value judgment pending" not in text
+    for value in FIELDS.values():
+        assert value in text
+
+
+def test_unreviewed_enqueue_cannot_replace_an_existing_reviewed_card(make_service):
+    service = make_service()
+    placeholder = service.runner.trace(URL)
+    service.trace(URL, analysis=assessment())
+    before = outbox(service)[0]
+    with service.knowledge.connection() as conn:
+        assert not delivery.enqueue(conn, placeholder, "webhook")
+    assert outbox(service)[0] == before
+
+
+def test_review_change_before_first_attempt_refreshes_one_pending_card(make_service):
+    service = make_service()
+    service.trace(URL, analysis=assessment())
+    before = outbox(service)[0]
+    old_key = previews(service)[0]["payload"]["idempotency_key"]
+    service.trace(URL, analysis=assessment(finding="更新审阅：接口范围明确，但未证明跨设备收益。"))
+    after = outbox(service)[0]
+    assert len(outbox(service)) == 1 and after["id"] == before["id"]
+    assert json.loads(after["report_json"])["summary"].startswith("更新审阅：")
+    assert previews(service)[0]["payload"]["idempotency_key"] == old_key
+
+
+def test_lost_ack_retry_keeps_identical_payload_after_review_change(make_service):
+    service = make_service()
+    service.trace(URL, analysis=assessment())
+    receipts = []
+    def lose_ack(channel, config, payload):
+        receipts.append(copy.deepcopy(payload))
+        raise OSError("simulated remote acceptance followed by lost acknowledgment")
+    assert flush(service, lose_ack)["retried"] == 1
+    before = outbox(service)[0]
+    assert before["attempts"] == 1 and before["next_chunk"] == 0
+    service.trace(URL, analysis=assessment(finding="新的本地审阅不能改写已尝试发送的消息正文。"))
+    assert outbox(service)[0] == before
+    assert flush(service, lambda c, config, payload: receipts.append(payload), now=101)["sent"] == 1
+    assert receipts[0] == receipts[1]
+
+
+def test_review_during_active_lease_cannot_replace_inflight_payload(make_service):
+    service = make_service()
+    service.trace(URL, analysis=assessment())
+    def during_send(channel, config, payload):
+        before = outbox(service)[0]
+        assert before["status"] == "leased" and before["lease_token"]
+        service.trace(URL, analysis=assessment(finding="发送期间的审阅更新只能改变本地报告。"))
+        assert outbox(service)[0] == before
+        assert payload["report"]["summary"] == FIELDS["finding"]
+    assert flush(service, during_send)["sent"] == 1
+    assert len(outbox(service)) == 1
+
+
+def test_acknowledged_chunks_and_remaining_chunks_keep_frozen_review(make_service):
+    service = make_service(channel="telegram")
+    long_finding = "这是模拟长篇审阅，用于验证分段持久化。" * 100
+    service.trace(URL, analysis=assessment(finding=long_finding))
+    initial = outbox(service)[0]
+    original_chunks = json.loads(initial["chunks_json"])
+    assert len(original_chunks) > 1
+    receipts = []
+    first = flush(service, lambda c, config, payload: receipts.append(payload["text"]), interval=10)
+    assert first["chunks_sent"] == 1 and first["sent"] == 0
+    before = outbox(service)[0]
+    assert before["status"] == "pending" and before["next_chunk"] == 1 and before["attempts"] == 0
+    service.trace(URL, analysis=assessment(finding="已确认首段后，即使新审阅更短也不得重排消息边界。"))
+    assert outbox(service)[0] == before
+    assert flush(service, lambda c, config, payload: receipts.append(payload["text"]), now=110)["sent"] == 1
+    assert receipts == original_chunks
+
+
+def test_sent_card_stays_immutable_and_reviewed_rechecks_do_not_alert_again(make_service):
+    service = make_service()
+    service.trace(URL, analysis=assessment())
+    assert flush(service, lambda *args: None)["sent"] == 1
+    before = outbox(service)[0]
+    service.trace(URL, analysis=assessment(finding="发送完成后修改审阅内容也不能产生重复 A 提醒。"))
+    assert len(outbox(service)) == 1 and outbox(service)[0] == before
+
+
+def test_delivery_log_freezes_payload_even_if_legacy_attempt_counter_is_reset(make_service):
+    service = make_service()
+    service.trace(URL, analysis=assessment())
+    def fail(*args):
+        raise OSError("simulated uncertain remote outcome")
+    flush(service, fail)
+    with service.knowledge.connection() as conn:
+        conn.execute("UPDATE intel_outbox SET attempts=0,next_attempt_at=0,last_error=NULL")
+        assert conn.execute("SELECT COUNT(*) FROM intel_delivery_log").fetchone()[0] == 1
+    before = outbox(service)[0]
+    service.trace(URL, analysis=assessment(finding="历史日志仍证明消息已尝试发送，不能替换正文。"))
+    assert outbox(service)[0] == before
+
+
+@pytest.mark.parametrize("lease_field,value", [("lease_token", "simulated-old-lease"), ("lease_until", 200)])
+def test_residual_lease_blocks_refresh_of_otherwise_unattempted_pending_job(make_service, lease_field, value):
+    service = make_service()
+    service.trace(URL, analysis=assessment())
+    with service.knowledge.connection() as conn:
+        conn.execute(f"UPDATE intel_outbox SET {lease_field}=?", (value,))
+    before = outbox(service)[0]
+    service.trace(URL, analysis=assessment(finding="残留租约必须先被可靠恢复，不能据计数为零替换消息。"))
+    assert outbox(service)[0] == before
+
+
+def test_completed_review_cannot_override_unrevalidated_primary_gate(make_service):
+    service = make_service()
+    service.runner.trace(URL)
+    service.resolver.failure = OSError("simulated primary resource unavailable")
+    report = service.trace(URL, refresh=True, analysis=assessment())
+    assert report["analysis"]["status"] == "evidence_linked_agent_review"
+    assert report["verification_status"] == "historical_primary_evidence; current_check_failed"
+    assert outbox(service) == []
+
+
+@pytest.mark.parametrize("frequency", ["daily", "weekly"])
+def test_unattended_digest_still_queues_and_discloses_required_agent_review(make_service, frequency):
+    service = make_service(threshold_a=100)
+    report = service.trace(URL)
+    assert report["tier"] == "B" and report["analysis"]["status"] == "agent_review_required"
+    with service.knowledge.connection() as conn:
+        conn.execute("UPDATE intel_revisions SET created_at='2026-10-11T12:00:00+00:00'")
+    result = service.briefing(frequency, now=datetime(2026, 10, 12, 1, tzinfo=timezone.utc))
+    assert result["queued"] == 1
+    assert result["report"]["analysis"]["status"] == "agent_review_required"
+    text = "".join(json.loads(outbox(service)[0]["chunks_json"]))
+    assert "agent_review_required" in text

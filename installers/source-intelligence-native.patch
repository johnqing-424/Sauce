@@ -0,0 +1,176 @@
+"""Review enrichment of real SQLite history using simulated source snapshots."""
+
+import copy
+import json
+
+import pytest
+
+from lib.intelligence import knowledge as knowledge_module
+from lib.intelligence.analysis import add_agent_analysis, build_report
+from lib.intelligence.knowledge import Knowledge
+from lib.intelligence.models import Document
+
+
+FIRST_SEEN = "2026-10-10T08:00:00+00:00"
+REVIEWED_AT = "2026-10-13T09:00:00+00:00"
+DAY = ("2026-10-10T00:00:00+00:00", "2026-10-11T00:00:00+00:00")
+WEEK = ("2026-10-05T00:00:00+00:00", "2026-10-12T00:00:00+00:00")
+
+
+@pytest.fixture
+def stored_placeholder(tmp_path, monkeypatch):
+    clock = [FIRST_SEEN]
+    monkeypatch.setattr(knowledge_module, "utc_now", lambda: clock[0])
+    knowledge = Knowledge(tmp_path / "research.db")
+    document = Document(
+        url="https://github.com/simulated/local-sdk",
+        title="simulated/local-sdk",
+        text="# Local SDK\n\n\nThe SDK executes local inference through a documented API.",
+        resource_type="repository",
+        primary_basis="simulated owned repository",
+        published_at="2026-10-01",
+        verified_at=FIRST_SEEN,
+        metadata={"content_scope": "repository_readme", "resource_kind": "repository"},
+    )
+    observation = {"url": document.url, "source": "github", "title": document.title}
+    report = build_report(observation, [document], [], [], {}, domain="AI", threshold_b=0)
+    knowledge.save_report(report, [document.url], observation)
+    return knowledge, report, document, observation, clock
+
+
+def reviewed_report(placeholder, document, *, finding="Local SDK offers a documented inference interface."):
+    report = copy.deepcopy(placeholder)
+    texts = {
+        "finding": finding,
+        "new": "The retrieved document describes a local interface; global novelty remains unknown.",
+        "why_it_matters": "A documented interface makes a small integration experiment possible.",
+        "application_potential": "Evaluate it in an application that requires local inference.",
+        "limitations": "Latency and compatibility have not been independently tested.",
+        "next_steps": "Run the documented API on the target machine and measure latency.",
+    }
+    add_agent_analysis(report, {"assessment": {
+        key: {"text": text, "evidence": [{"url": document.url, "quote": document.text}]}
+        for key, text in texts.items()
+    }}, [document])
+    return report
+
+
+def stored_report(knowledge, event_id, revision, surface):
+    if surface == "latest_event":
+        return knowledge.get_event(event_id)
+    if surface == "revision_history":
+        with knowledge.connection() as conn:
+            row = conn.execute(
+                "SELECT report_json FROM intel_revisions WHERE event_id=? AND revision=?",
+                (event_id, revision),
+            ).fetchone()
+        return json.loads(row[0])
+    since, until = DAY if surface == "daily_period" else WEEK
+    reports = knowledge.reports(since=since, until=until)
+    assert len(reports) == 1
+    return reports[0]
+
+
+@pytest.mark.parametrize("surface", ["latest_event", "revision_history", "daily_period", "weekly_period"])
+def test_completed_assessment_enriches_original_material_revision(stored_placeholder, surface):
+    knowledge, placeholder, document, observation, clock = stored_placeholder
+    clock[0] = REVIEWED_AT
+    reviewed = reviewed_report(placeholder, document)
+    knowledge.save_report(reviewed, [document.url], observation)
+
+    persisted = stored_report(knowledge, placeholder["id"], placeholder["revision"], surface)
+    assert persisted["summary"] == reviewed["summary"]
+    assert persisted["analysis"]["agent_assessment"] == reviewed["analysis"]["agent_assessment"]
+    assert persisted["analysis"]["status"] == "evidence_linked_agent_review"
+
+
+def test_review_enrichment_preserves_identity_and_original_observation_window(stored_placeholder):
+    knowledge, placeholder, document, observation, clock = stored_placeholder
+    clock[0] = REVIEWED_AT
+    reviewed = reviewed_report(placeholder, document)
+    reviewed["id"] = "different-proposed-event-id"
+    result = knowledge.save_report(reviewed, [document.url], observation)
+
+    assert result["id"] == placeholder["id"]
+    assert result["revision"] == placeholder["revision"]
+    assert result["persistence"]["change"] == "unchanged"
+    assert knowledge.reports(since=REVIEWED_AT) == []
+    with knowledge.connection() as conn:
+        event = conn.execute("SELECT first_seen,updated_at FROM intel_events").fetchone()
+        revision = conn.execute("SELECT created_at,report_json FROM intel_revisions").fetchone()
+        assert tuple(event) == (FIRST_SEEN, FIRST_SEEN)
+        assert revision["created_at"] == FIRST_SEEN
+        assert json.loads(revision["report_json"])["summary"] == reviewed["summary"]
+        assert conn.execute("SELECT COUNT(*) FROM intel_events").fetchone()[0] == 1
+        assert conn.execute("SELECT COUNT(*) FROM intel_revisions").fetchone()[0] == 1
+        assert conn.execute("SELECT COUNT(*) FROM intel_observations").fetchone()[0] == 1
+        # Saving still records a check; review enrichment must not alter monitoring counts.
+        assert conn.execute("SELECT seen_count FROM intel_observations").fetchone()[0] == 2
+
+
+@pytest.mark.parametrize("surface", ["latest_event", "revision_history", "daily_period"])
+def test_same_revision_unreviewed_save_cannot_erase_valid_assessment(stored_placeholder, surface):
+    knowledge, placeholder, document, observation, clock = stored_placeholder
+    clock[0] = REVIEWED_AT
+    reviewed = reviewed_report(placeholder, document)
+    knowledge.save_report(reviewed, [document.url], observation)
+
+    clock[0] = "2026-10-14T09:00:00+00:00"
+    unreviewed = copy.deepcopy(placeholder)
+    unreviewed["failures"] = [{"url": document.url, "status": "partial_refresh"}]
+    knowledge.save_report(unreviewed, [document.url], observation)
+
+    persisted = stored_report(knowledge, placeholder["id"], placeholder["revision"], surface)
+    assert persisted["summary"] == reviewed["summary"]
+    assert persisted["analysis"]["agent_assessment"] == reviewed["analysis"]["agent_assessment"]
+    assert persisted["failures"] == unreviewed["failures"]
+
+
+def test_new_material_revision_requires_new_assessment(stored_placeholder):
+    knowledge, placeholder, document, observation, clock = stored_placeholder
+    clock[0] = REVIEWED_AT
+    reviewed = reviewed_report(placeholder, document)
+    knowledge.save_report(reviewed, [document.url], observation)
+    changed = Document.from_dict(dict(document.to_dict(), text=document.text + "\nThe next release changes the interface.", content_hash=""))
+    clock[0] = "2026-10-14T09:00:00+00:00"
+    unreviewed = build_report(observation, [changed], [], [], {}, domain="AI", threshold_b=0)
+    knowledge.save_report(unreviewed, [document.url], observation)
+
+    current = knowledge.get_event(placeholder["id"])
+    assert current["revision"] != placeholder["revision"]
+    assert current["analysis"]["status"] == "agent_review_required"
+    assert "agent_assessment" not in current["analysis"]
+    prior_day = knowledge.reports(since=DAY[0], until=DAY[1])[0]
+    assert prior_day["analysis"]["agent_assessment"] == reviewed["analysis"]["agent_assessment"]
+
+
+def test_retaining_assessment_preserves_new_evidence_linked_insights(stored_placeholder):
+    knowledge, placeholder, document, observation, clock = stored_placeholder
+    clock[0] = REVIEWED_AT
+    reviewed = reviewed_report(placeholder, document)
+    knowledge.save_report(reviewed, [document.url], observation)
+    incoming = copy.deepcopy(placeholder)
+    add_agent_analysis(incoming, {"insights": [{
+        "text": "Compare the documented interface with the target application's integration needs.",
+        "evidence": [{"url": document.url, "quote": document.text}],
+    }]}, [document])
+    expected_insights = copy.deepcopy(incoming["analysis"]["agent_insights"])
+    knowledge.save_report(incoming, [document.url], observation)
+
+    persisted = knowledge.get_event(placeholder["id"])
+    assert persisted["analysis"]["agent_insights"] == expected_insights
+    assert persisted["analysis"]["agent_assessment"] == reviewed["analysis"]["agent_assessment"]
+
+
+def test_storage_cannot_restore_assessment_when_same_revision_quotes_no_longer_match(stored_placeholder):
+    knowledge, placeholder, document, observation, clock = stored_placeholder
+    clock[0] = REVIEWED_AT
+    knowledge.save_report(reviewed_report(placeholder, document), [document.url], observation)
+    reformatted = Document.from_dict(dict(document.to_dict(), text=document.text.replace("\n\n\n", "\n\n"), content_hash=""))
+    unreviewed = build_report(observation, [reformatted], [], [], {}, domain="AI", threshold_b=0)
+    assert unreviewed["revision"] == placeholder["revision"]
+    knowledge.save_report(unreviewed, [document.url], observation)
+
+    current = knowledge.get_event(placeholder["id"])
+    assert current["analysis"]["status"] == "agent_review_required"
+    assert "agent_assessment" not in current["analysis"]

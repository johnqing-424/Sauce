+def _reserve_rate(conn: sqlite3.Connection, channel: str, now: float, interval: float):
+    conn.execute("""INSERT INTO intel_delivery_rate_limits(channel,next_send_at) VALUES (?,?)
+        ON CONFLICT(channel) DO UPDATE SET next_send_at=excluded.next_send_at""", (channel, now + interval))
+

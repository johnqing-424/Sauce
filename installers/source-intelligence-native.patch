+def enqueue(conn: sqlite3.Connection, report: dict, channel: str, tier: str = "A", period_key: str = "") -> bool:
+    """Persist once; safely refresh reviewed, never-attempted pending A cards.
+
+    False still means duplicate/hold, including an existing card refreshed in
+    place. Attempted payloads stay immutable under their stable idempotency keys.
+    """
+    if not isinstance(report, dict):
+        raise DeliveryError("invalid_report")
+    if report.get("tier") == "hold" or tier == "hold":
+        return False
+    if channel not in CHANNELS or tier not in {"A", "B", "C"} or not isinstance(period_key, str):
+        raise DeliveryError("invalid_config")
+    if not all(isinstance(report.get(key), str) and report[key].strip() for key in ("id", "revision")):
+        raise DeliveryError("invalid_report")
+    try:
+        serialized = _json(report)
+        chunks = _chunks(_card(report, tier, period_key), channel)
+    except (TypeError, ValueError, AttributeError, UnicodeError):
+        raise DeliveryError("invalid_report") from None
+    init_schema(conn)
+    created = time.time()
+    with _savepoint(conn):
+        cursor = conn.execute("""INSERT INTO intel_outbox
+            (event_id,revision,channel,tier,period_key,report_json,chunks_json,total_chunks,created_at,updated_at)
+            VALUES (?,?,?,?,?,?,?,?,?,?)
+            ON CONFLICT(event_id,revision,channel,tier,period_key) DO NOTHING""",
+            (report["id"], report["revision"], channel, tier, period_key, serialized, _json(chunks), len(chunks), created, created))
+        inserted = cursor.rowcount == 1
+        if not inserted and tier == "A" and has_completed_agent_review(report):
+            # The insert holds the write lock through this update. A concurrent
+            # worker either claims the old immutable body or the refreshed one;
+            # a claimed, attempted or acknowledged payload is never replaced.
+            conn.execute("""UPDATE intel_outbox SET report_json=?,chunks_json=?,total_chunks=?,updated_at=?
+                WHERE event_id=? AND revision=? AND channel=? AND tier=? AND period_key=?
+                AND status='pending' AND next_chunk=0 AND attempts=0
+                AND lease_token IS NULL AND lease_until IS NULL
+                AND NOT EXISTS (SELECT 1 FROM intel_delivery_log l WHERE l.outbox_id=intel_outbox.id)
+                AND report_json<>?""",
+                (serialized, _json(chunks), len(chunks), created, report["id"], report["revision"],
+                 channel, tier, period_key, serialized))
+    return inserted
+

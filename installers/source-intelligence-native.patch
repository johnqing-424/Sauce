+def test_registry_hint_uses_only_loopback_proxy_endpoints():
+    repair = repair_module()
+    assert repair.proxy_candidates('http=127.0.0.1:7897;https=127.0.0.1:7897')[0] == 'http://127.0.0.1:7897'
+    candidates = repair.proxy_candidates('http=user:secret@remote.example:8000')
+    assert candidates == ['http://127.0.0.1:7897', 'http://127.0.0.1:7890']
+
+
+@pytest.mark.parametrize('historical, expected', [(False, 0), (True, 3)])
+def test_successful_proxy_probe_cannot_mislabel_failed_trace_with_old_evidence(historical, expected, monkeypatch, tmp_path, capsys):
+    from lib.intelligence import service
+    repair = repair_module()
+    source, installed = package(tmp_path)
+    profile = tmp_path / 'intelligence.json'
+    profile.write_text('{"threshold_a":92}')
+    freshness = 'historical_not_revalidated' if historical else 'retrieved_or_cached'
+    simulated_report = {
+        'resources': [{'url': repair.PROBE_URL, 'metadata': {'freshness_status': freshness}}],
+        'evidence': [{'url': repair.PROBE_URL, 'freshness_status': freshness}],
+        'verification_status': 'historical_primary_evidence; current_check_failed' if historical else 'primary_material_retrieved',
+        'report_path': str(tmp_path / 'simulated.json'), 'markdown_path': str(tmp_path / 'simulated.md'),
+        'failures': [{'url': repair.PROBE_URL, 'status': 'timeout'}] if historical else [],
+    }
+    captured = []
+    def trace(url, refresh):
+        captured.append((url, refresh))
+        return simulated_report
+    monkeypatch.setattr(service, 'IntelligenceService', lambda settings: SimpleNamespace(trace=trace))
+    monkeypatch.setattr(repair, 'probe_proxy', lambda url: True)
+    monkeypatch.setattr(sys, 'argv', ['repair_clash.py', '--payload', str(source), '--skill-dir', str(installed),
+                                     '--config', str(profile), '--proxy', 'http://127.0.0.1:7897'])
+    assert repair.main() == expected
+    output = capsys.readouterr().out
+    assert ('external_trace_verified' in output) is not historical
+    assert captured == [(repair.PROBE_URL, True)]

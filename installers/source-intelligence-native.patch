+"""Offline CLI acceptance; all retrieved resources in this file are simulated."""
+
+import json
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+
+import intelligence
+from lib.intelligence import engine
+from lib.intelligence.models import Budget, Document, Limits, Link
+from lib.intelligence.knowledge import Knowledge
+
+
+class SimulatedSources:
+    last_failures = []
+
+    def __init__(self):
+        self.domains = []
+        self.documents = {
+            "https://github.com/simulated/robot": Document(
+                url="https://github.com/simulated/robot", title="simulated/robot",
+                text="New robot control toolkit with a documented SDK.", resource_type="repository",
+                primary_basis="owned_repository", version="v1",
+                links=[Link("https://docs.test/robot", "documentation", "SDK docs", "README:1")]),
+            "https://docs.test/robot": Document(url="https://docs.test/robot", text="SDK usage examples.", resource_type="documentation"),
+        }
+
+    def discover(self, domain, budget, since, limit=8):
+        budget.take()
+        self.domains.append(domain)
+        return [{"url": "https://github.com/simulated/robot", "source": "github", "title": "Robot toolkit"}]
+
+    def fetch(self, url, budget):
+        budget.take()
+        return self.documents[url]
+
+
+def cli_paths(tmp_path):
+    return ["--db", str(tmp_path / "research.db"), "--report-dir", str(tmp_path / "reports")]
+
+
+def no_engine(domain, budget, **kwargs):
+    budget.take()
+    return {"candidates": [], "source_status": {"hackernews": {"state": "no-results"}}, "real_external": False, "test_fixture": True}
+
+
+def test_domain_only_discovery_closes_trace_storage_and_report_loop(tmp_path, capsys):
+    resolver = SimulatedSources()
+    code = intelligence.main(cli_paths(tmp_path) + ["discover", "robotics"], resolver=resolver, engine_fn=no_engine)
+    assert code == 0
+    result = json.loads(capsys.readouterr().out)
+    assert resolver.domains == ["robotics"]
+    assert result["reports"][0]["source_trace"]["creator_direct"]
+    assert result["reports"][0]["graph"]["edges"][0]["target_verified"]
+    assert result["upstream"]["source_status"]["hackernews"]["state"] == "no-results"
+    assert Path(result["reports"][0]["report_path"]).is_file()
+    assert list((tmp_path / "reports").glob("*.md"))
+    with Knowledge(tmp_path / "research.db").connection() as conn:
+        assert conn.execute("SELECT COUNT(*) FROM intel_events").fetchone()[0] == 1
+
+
+def test_repeated_discovery_reuses_history_and_does_not_create_revision(tmp_path, capsys):

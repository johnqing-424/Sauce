+"""Discovery triage, trusted query data, and fair slices of one run budget.
+
+Resource shapes decide what to inspect, never whether a breakthrough is true
+or valuable. Semantic judgment belongs to the hosting agent after collection.
+"""
+
+from __future__ import annotations
+
+import hashlib

+"""Simulated proxy checks and real temporary-filesystem upgrade checks.
+
+No Windows registry, external website or notification service is contacted.
+"""
+import hashlib
+import importlib.util
+import json
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+
+def repair_module():
+    path = Path(__file__).resolve().parents[1] / 'deploy/intelligence/repair_clash.py'
+    assert path.is_file(), 'The standalone Clash repair helper is not implemented'
+    spec = importlib.util.spec_from_file_location('intel_network_repair', path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def package(tmp_path):
+    source = tmp_path / 'payload'
+    installed = tmp_path / 'home/.agents/skills/last30days'
+    files = {}
+    for name in ('transport', 'configuration', 'service'):
+        relative = f'scripts/lib/intelligence/{name}.py'
+        old, new = b'VERSION = "before"\n', b'VERSION = "after"\n'
+        for root, content in ((source, new), (installed, old)):
+            path = root / relative
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_bytes(content)
+        files[relative] = {'before': hashlib.sha256(old).hexdigest(), 'after': hashlib.sha256(new).hexdigest()}
+    (source / 'manifest.json').write_text(json.dumps({'format': 1, 'files': files}))
+    return source, installed
+
+
+def test_repair_updates_and_backs_up_only_expected_files(tmp_path):
+    source, installed = package(tmp_path)
+    personal = installed.parent.parent.parent / '.config/last30days/private.env'
+    personal.parent.mkdir(parents=True)
+    personal.write_text('Unrelated private configuration')
+    (installed / 'custom.txt').write_text('keep customization')
+    result = repair_module().update_skill(source, installed)
+    assert result['status'] == 'updated'
+    assert (installed / 'scripts/lib/intelligence/transport.py').read_text() == 'VERSION = "after"\n'
+    assert (Path(result['backup']) / 'scripts/lib/intelligence/transport.py').read_text() == 'VERSION = "before"\n'
+    assert (installed / 'custom.txt').read_text() == 'keep customization'
+    assert personal.read_text() == 'Unrelated private configuration'
+
+
+def test_repair_is_idempotent(tmp_path):
+    source, installed = package(tmp_path)
+    repair = repair_module()
+    first = repair.update_skill(source, installed)
+    assert repair.update_skill(source, installed) == {'status': 'already_updated', 'backup': None}
+    assert [p.name for p in installed.parent.iterdir() if 'network-backup' in p.name] == [Path(first['backup']).name]
+
+
+@pytest.mark.parametrize('change', ['customized', 'corrupt_payload', 'path_escape', 'symlink_parent'])
+def test_repair_rejects_unsafe_or_unexpected_files_before_any_change(change, tmp_path):
+    source, installed = package(tmp_path)
+    if change == 'customized':
+        (installed / 'scripts/lib/intelligence/service.py').write_text('CUSTOM = True')
+    elif change == 'corrupt_payload':
+        (source / 'scripts/lib/intelligence/service.py').write_text('corrupt')
+    elif change == 'path_escape':
+        manifest = json.loads((source / 'manifest.json').read_text())
+        manifest['files']['../outside.py'] = next(iter(manifest['files'].values()))
+        (source / 'manifest.json').write_text(json.dumps(manifest))
+    else:
+        real = tmp_path / 'outside'
+        (installed / 'scripts/lib').rename(real)
+        (installed / 'scripts/lib').symlink_to(real, target_is_directory=True)
+    with pytest.raises(ValueError):
+        repair_module().update_skill(source, installed)
+    assert (installed / 'scripts/lib/intelligence/transport.py').read_text() == 'VERSION = "before"\n'
+    assert not list(installed.parent.glob('.last30days-network-backup-*'))
+
+
+def test_repair_restores_replaced_files_if_upgrade_fails(monkeypatch, tmp_path):
+    source, installed = package(tmp_path)
+    repair = repair_module()
+    replace = repair.os.replace
+    failed = False
+    def fail_once(old, new):
+        nonlocal failed
+        if Path(new).name == 'service.py' and not failed:
+            failed = True
+            raise OSError('simulated disk failure')
+        return replace(old, new)
+    monkeypatch.setattr(repair.os, 'replace', fail_once)
+    with pytest.raises(OSError):
+        repair.update_skill(source, installed)
+    for name in ('transport', 'configuration', 'service'):
+        assert (installed / f'scripts/lib/intelligence/{name}.py').read_text() == 'VERSION = "before"\n'
+
+

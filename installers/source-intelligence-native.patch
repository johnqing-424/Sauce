+                    known = self.knowledge.find_event([candidate["url"]])
+                    if known:
+                        for observation in candidate["observations"]:
+                            self.knowledge.record_observation(known["id"], observation)
+            outcomes = upstream.get("source_status", {})
+            degraded = failures or any((value.get("state") if isinstance(value, dict) else value) not in {"ok", "no-results"} for value in outcomes.values())
+            has_findings = bool(candidates) if collect_only else bool(reports)
+            partial_trace = any(report["failures"] or report["exploration"]["truncated"] for report in reports)
+            result = {"schema_version": "last30days-intelligence-run/1", "domain": domain,
+                      "status": "partial" if degraded or partial_trace or native_search else "completed" if has_findings else "no-results",
+                      "upstream": upstream, "source_failures": failures, "reports": reports,
